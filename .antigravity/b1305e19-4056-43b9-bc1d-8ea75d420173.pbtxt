          text: "        const xPos = (width / 16) * i + (width / 32) * Math.sin(phase * 0.01 + i);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const barHeight = isPlaying "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          ? (Math.abs(Math.sin(phase * 0.05 + i)) * (midY - 10) + 5)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          : (Math.abs(Math.sin(i * 12)) * 10 + 2);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ctx.fillStyle = i % 2 === 0 ? \'rgba(208, 188, 255, 0.25)\' : \'rgba(78, 222, 163, 0.25)\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ctx.fillRect(xPos - 3, midY - barHeight / 2, 6, barHeight);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      phase += 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      rAFId = requestAnimationFrame(render);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    };"
