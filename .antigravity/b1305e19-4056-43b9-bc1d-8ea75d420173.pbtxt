  file_change {
    absolute_path_uri: "file:///src/components/AnalyticsView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useEffect, useState } from \'react\';\nimport { \n  ResponsiveContainer, \n  AreaChart, \n  Area, \n  XAxis, \n  YAxis, \n  Tooltip, \n  PieChart, \n  Pie, \n  Cell, \n  BarChart, \n  Bar, \n  Legend \n} from \'recharts\';\nimport { \n  Activity, \n  Compass, \n  Volume2, \n  Cpu, \n  TrendingUp, \n  CheckCircle2, \n  Flame, \n  Music,\n  LineChart,\n  PieChart as PieIcon,\n  ListFilter\n} from \'lucide-react\';\nimport { Song, Playlist } from \'../types\';\nimport { staticHabitsData } from \'../data\';\n\ninterface AnalyticsViewProps {\n  songs: Song[];\n  playlists: Playlist[];\n  currentSong: Song;\n  isPlaying: boolean;\n}\n\nexport default function AnalyticsView({ songs, playlists, currentSong, isPlaying }: AnalyticsViewProps) {\n  // Real-time ticking values\n  const [liveBitrate, setLiveBitrate] = useState(320);\n  const [liveDB, setLiveDB] = useState(55);\n  const [bufferStatus, setBufferStatus] = useState(99.2);\n  const [packetHealth, setPacketHealth] = useState(100);\n\n  // Selected playlist to analyze (null represents analyzing the general Library)\n  const [analyzedPlaylistId, setAnalyzedPlaylistId] = useState<string>(\'all-library\');\n\n  // Continual telemetry feedback\n  useEffect(() => {\n    let bitrateTarget = currentSong.genre === \'Synthwave\' || currentSong.genre === \'Ambient Electronica\' ? 960 : 320;\n    const timer = setInterval(() => {\n      if (isPlaying) {\n        setLiveBitrate(prev => {\n          const change = Math.random() > 0.5 ? 8 : -8;\n          return Math.max(bitrateTarget - 30, Math.min(bitrateTarget + 30, prev === 128 ? bitrateTarget : prev + change));\n        });\n        setLiveDB(prev => {\n          const change = Math.floor(Math.random() * 8) - 4;\n          return Math.max(50, Math.min(82, prev + change));\n        });\n        setBufferStatus(prev => Math.max(98.5, Math.min(100, prev + (Math.random() * 0.2 - 0.1))));\n        setPacketHealth(prev => Math.max(99.8, Math.min(100, prev + (Math.random() * 0.1 - 0.05))));\n      } else {\n        setLiveBitrate(128); // Standby rate\n        setLiveDB(0); // Silence index\n        setBufferStatus(100);\n        setPacketHealth(100);\n      }\n    }, 1200);\n\n    return () => clearInterval(timer);\n  }, [isPlaying, currentSong]);\n\n  // Find currently analyzed playlist\n  const activePlaylist = playlists.find(p => p.id === analyzedPlaylistId);\n\n  // Hydrate target tracks based on scope\n  const targetTracks = activePlaylist \n    ? songs.filter(s => activePlaylist.songIds.includes(s.id))\n    : songs;\n\n  // Calculate stats dynamically for chosen scope!\n  const tracksCount = targetTracks.length;\n  const totalDurationSecs = targetTracks.reduce((acc, s) => acc + s.durationSec, 0);\n  const avgDurationMin = tracksCount > 0 ? (totalDurationSecs / tracksCount / 60).toFixed(1) : \'0\';\n  \n  // Calculate potential aggregate data streamed in full listening\n  const estimatedStreamMB = ((totalDurationSecs * (isPlaying ? liveBitrate : 320)) / 8 / 1024).toFixed(1);\n\n  // Compute genre breakdown percentages dynamically!\n  const genreCounts: Record<string, number> = {};\n  targetTracks.forEach((track) => {\n    genreCounts[track.genre] = (genreCounts[track.genre] || 0) + 1;\n  });\n\n  const topGenreColorMap: Record<string, string> = {\n    \'Synthwave\': \'#d0bcff\',\n    \'Ambient Electronica\': \'#4edea3\',\n    \'Lo-Fi Beats\': \'#ffd0bc\',\n    \'Classical Redefined\': \'#ffafd3\',\n    \'Vocal Jazz\': \'#cbd5e1\',\n    \'Ambient Soundscape\': \'#a078ff\'\n  };\n\n  const dynamicGenreBreakdown = Object.entries(genreCounts).map(([name, count]) => {\n    const value = Math.round((count / (tracksCount || 1)) * 100);\n    const color = topGenreColorMap[name] || \'#a078ff\';\n    return { name, value, color };\n  }).sort((a, b) => b.value - a.value);\n\n  // Identify highest occurrence genre title\n  const topGenreTitle = dynamicGenreBreakdown.length > 0 ? dynamicGenreBreakdown[0].name : \'Empty\';\n\n  // Customize dynamic habits data to mimic bandwidth variations based on scope\n  const dynamicHabitsData = staticHabitsData.map(d => ({\n    ...d,\n    bandwidth: Math.round(d.hours * (tracksCount || 5) * 52)\n  }));\n\n  return (\n    <div className=\"space-y-8 animate-fade-in pr-2 select-none\">\n      \n      {/* 1. Header Hero Segment */}\n      <section className=\"flex flex-col md:flex-row md:items-center justify-between pb-4 border-b border-[#ffffff]/5\">\n        <div>\n          <h2 className=\"font-display text-3xl font-extrabold text-obsidian-on-surface tracking-tight flex items-center gap-3\">\n            <Activity className=\"w-8 h-8 text-secondary-emerald animate-pulse\" />\n            <span>H-Fi Playlist Analytics</span>\n          </h2>\n          <p className=\"text-xs text-obsidian-on-surface-variant/40 mt-1 font-medium font-sans\">\n            Real-time lossy stream telemetry dynamically analyzed for selected compilation playlist\n          </p>\n        </div>\n\n        {/* Playlist selection dropdown */}\n        <div className=\"flex items-center gap-3 mt-4 md:mt-0 flex-wrap sm:flex-nowrap\">\n          <div className=\"flex items-center gap-1.5 bg-obsidian-container-low px-4 py-2.5 rounded-full border border-white/5\">\n            <ListFilter className=\"w-4 h-4 text-primary-electric\" />\n            <select\n              value={analyzedPlaylistId}\n              onChange={(e) => setAnalyzedPlaylistId(e.target.value)}\n              className=\"bg-transparent border-none text-obsidian-on-surface text-xs font-bold font-sans outline-none cursor-pointer\"\n            >\n              <option value=\"all-library\">All Library Tracks ({songs.length})</option>\n              {playlists.map(pl => (\n                <option key={pl.id} value={pl.id}>\n                  Playlist: {pl.name} ({pl.songIds.length} tracks)\n                </option>\n              ))}\n            </select>\n          </div>\n\n          <div className=\"bg-obsidian-container-low border border-white/5 px-4 py-2.5 rounded-full flex items-center gap-2\">\n            <span className=\"w-2.5 h-2.5 bg-secondary-emerald rounded-full animate-ping\" />\n            <span className=\"text-[10px] font-mono font-bold text-secondary-emerald uppercase tracking-wider\">\n              STREAM DECODER: {liveBitrate} KBPS\n            </span>\n          </div>\n        </div>\n      </section>\n\n      {/* 2. Grid metrics highlights of chosen compilation */}\n      <section className=\"grid grid-cols-2 lg:grid-cols-4 gap-6\">\n        \n        {/* Dynamic Songs Count Card */}\n        <div className=\"bg-obsidian-container-low p-5 rounded-2xl border border-white/5 relative overflow-hidden group\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-obsidian-on-surface-variant/40\">\n              Compilation Tracks\n            </span>\n            <Music className=\"w-4 h-4 text-primary-electric\" />\n          </div>\n          <div className=\"mt-4 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-extrabold text-obsidian-on-surface tracking-tight font-display\">\n              {tracksCount}\n            </span>\n            <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono\">tracks</span>\n          </div>\n          <p className=\"text-[10px] text-primary-electric/75 mt-2 font-semibold\">\n            {activePlaylist ? `Public code: ${activePlaylist.id}` : \'General available catalogue\'}\n          </p>\n        </div>\n\n        {/* Expected Bandwidth Card */}\n        <div className=\"bg-obsidian-container-low p-5 rounded-2xl border border-white/5 relative overflow-hidden group\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-obsidian-on-surface-variant/40\">\n              Expected Bandwidth\n            </span>\n            <Cpu className=\"w-4 h-4 text-secondary-emerald\" />\n          </div>\n          <div className=\"mt-4 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-extrabold text-obsidian-on-surface tracking-tight font-display\">\n              {estimatedStreamMB}\n            </span>\n            <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono\">MB FLAC</span>\n          </div>\n          <p className=\"text-[10px] text-secondary-emerald/75 mt-2 font-semibold\">\n            Estimated payload size for full play\n          </p>\n        </div>\n\n        {/* Average track length */}\n        <div className=\"bg-obsidian-container-low p-5 rounded-2xl border border-white/5 relative overflow-hidden group\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-obsidian-on-surface-variant/40\">\n              Average Track Length\n            </span>\n            <CheckCircle2 className=\"w-4 h-4 text-amber-300\" />\n          </div>\n          <div className=\"mt-4 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-extrabold text-obsidian-on-surface tracking-tight font-display\">\n              {avgDurationMin}\n            </span>\n            <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono\">minutes</span>\n          </div>\n          <p className=\"text-[10px] text-amber-300/75 mt-2 font-semibold\">\n            Calculated dynamic mean index\n          </p>\n        </div>\n\n        {/* Live Audio Decibels feedback */}\n        <div className=\"bg-obsidian-container-low p-5 rounded-2xl border border-white/5 relative overflow-hidden group\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-obsidian-on-surface-variant/40\">\n              Acoustic Amplitude\n            </span>\n            <Volume2 className=\"w-4 h-4 text-red-400\" />\n          </div>\n          <div className=\"mt-4 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-extrabold text-obsidian-on-surface tracking-tight font-display\">\n              {isPlaying ? liveDB : \'0\'}\n            </span>\n            <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono\">dB ESP</span>\n          </div>\n          <p className=\"text-[10px] text-red-400/75 mt-2 font-semibold\">\n            {isPlaying ? \'Lossless transducer feedback active\' : \'Player standby signal\'}\n          </p>\n        </div>\n\n      </section>\n\n      {/* 3. Recharts Area Chart and Pie Chart side-by-side */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        \n        {/* Dynamic Bandwidth and listening habits (8 columns) */}\n        <div className=\"lg:col-span-8 bg-obsidian-container-low p-6 rounded-3xl border border-white/5\">\n          <div className=\"flex items-center justify-between mb-6\">\n            <div className=\"flex items-center gap-2\">\n              <LineChart className=\"w-5 h-5 text-primary-electric\" />\n              <h3 className=\"font-display text-lg font-bold text-obsidian-on-surface tracking-tight\">\n                Selected Playlist Bandwidth Matrix\n              </h3>\n            </div>\n            <span className=\"text-[10px] font-bold text-obsidian-on-surface-variant/40 tracking-wider\">\n              DYNAMIC 7 DAYS MATRIX\n            </span>\n          </div>\n\n          <div className=\"h-72\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={dynamicHabitsData} margin={{ top: 10, right: 10, left: -25, bottom: 0 }}>\n                <defs>\n                  <linearGradient id=\"hoursGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#d0bcff\" stopOpacity={0.4} />\n                    <stop offset=\"95%\" stopColor=\"#d0bcff\" stopOpacity={0.0} />\n                  </linearGradient>\n                  <linearGradient id=\"dbGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#4edea3\" stopOpacity={0.3} />\n                    <stop offset=\"95%\" stopColor=\"#4edea3\" stopOpacity={0.0} />\n                  </linearGradient>\n                </defs>\n                <XAxis \n                  dataKey=\"day\" \n                  stroke=\"#cbc3d7\" \n                  fontSize={10} \n                  tickLine={false} \n                  axisLine={false} \n                  style={{ opacity: 0.5 }}\n                />\n                <YAxis \n                  stroke=\"#cbc3d7\" \n                  fontSize={10} \n                  tickLine={false} \n                  axisLine={false} \n                  style={{ opacity: 0.5 }}\n                />\n                <Tooltip \n                  contentStyle={{ \n                    backgroundColor: \'#1c1b1b\', \n                    borderRadius: \'12px\', \n                    border: \'1px solid rgba(255,255,255,0.08)\',\n                    color: \'#fff\',\n                    fontFamily: \'Inter\',\n                    fontSize: \'11px\'\n                  }} \n                />\n                <Area \n                  type=\"monotone\" \n                  dataKey=\"bandwidth\" \n                  name=\"Megabytes Transferred\"\n                  stroke=\"#d0bcff\" \n                  strokeWidth={2.5}\n                  fillOpacity={1} \n                  fill=\"url(#hoursGrad)\" \n                />\n                <Area \n                  type=\"monotone\" \n                  dataKey=\"hours\" \n                  name=\"Stream Hours Logged\" \n                  stroke=\"#4edea3\" \n                  strokeWidth={1.5}\n                  fillOpacity={1} \n                  fill=\"url(#dbGrad)\" \n                  strokeDasharray=\"4 4\"\n                />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Dynamic Genres Pie Breakdown based on playlist (4 columns) */}\n        <div className=\"lg:col-span-4 bg-obsidian-container-low p-6 rounded-3xl border border-white/5 flex flex-col justify-between\">\n          <div className=\"flex items-center gap-2 mb-4\">\n            <PieIcon className=\"w-5 h-5 text-secondary-emerald\" />\n            <h3 className=\"font-display text-lg font-bold text-obsidian-on-surface tracking-tight\">\n              Acoustic Profile\n            </h3>\n          </div>\n\n          <div className=\"h-48 relative flex items-center justify-center\">\n            {dynamicGenreBreakdown.length === 0 ? (\n              <span className=\"text-xs text-obsidian-on-surface-variant/40 italic\">Empty scope profile</span>\n            ) : (\n              <ResponsiveContainer width=\"100%\" height=\"100%\">\n                <PieChart>\n                  <Pie\n                    data={dynamicGenreBreakdown}\n                    cx=\"50%\"\n                    cy=\"50%\"\n                    innerRadius={55}\n                    outerRadius={75}\n                    paddingAngle={4}\n                    dataKey=\"value\"\n                  >\n                    {dynamicGenreBreakdown.map((entry, index) => (\n                      <Cell key={`cell-${index}`} fill={entry.color} />\n                    ))}\n                  </Pie>\n                  <Tooltip \n                    contentStyle={{ \n                      backgroundColor: \'#1c1b1b\', \n                      borderRadius: \'12px\', \n                      border: \'1px solid rgba(255,255,255,0.08)\',\n                      color: \'#fff\',\n                      fontFamily: \'Inter\',\n                      fontSize: \'11px\'\n                    }} \n                  />\n                </PieChart>\n              </ResponsiveContainer>\n            )}\n            \n            {/* Center dynamic title labels representing analyzed top genre strictly */}\n            <div className=\"absolute flex flex-col items-center select-none text-center px-6\">\n              <span className=\"text-[9px] font-mono text-obsidian-on-surface-variant/40 uppercase tracking-widest font-bold\">\n                TOP GENRE\n              </span>\n              <span className=\"text-obsidian-on-surface text-[11px] font-bold font-sans mt-0.5 truncate max-w-[100px]\" title={topGenreTitle}>\n                {topGenreTitle}\n              </span>\n            </div>\n          </div>\n\n          {/* Dynamic Table Labels breakdown */}\n          <div className=\"mt-4 space-y-1.5 flex-1 overflow-y-auto custom-scrollbar\">\n            {dynamicGenreBreakdown.length === 0 ? (\n              <p className=\"text-[11px] text-zinc-400 italic text-center py-4\">Add tracks to generate acoustic profile matrix.</p>\n            ) : (\n              dynamicGenreBreakdown.map((item, id) => (\n                <div key={id} className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-2.5\">\n                    <div style={{ backgroundColor: item.color }} className=\"w-2.5 h-2.5 rounded-full\" />\n                    <span className=\"text-obsidian-on-surface-variant/80 font-medium font-sans\">\n                      {item.name}\n                    </span>\n                  </div>\n                  <span className=\"text-obsidian-on-surface font-mono font-bold\">\n                    {item.value}%\n                  </span>\n                </div>\n              ))\n            )}\n          </div>\n\n        </div>\n\n      </section>\n\n    </div>\n  );\n}\n"
    }
