    replacement_chunks {
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-display: \"Sora\", \"Inter\", sans-serif;\n  --font-mono: \"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace;\n\n  /* Sonic Obsidian Custom Design Theme Tokens */\n  --color-primary-electric: #d0bcff;\n  --color-primary-dark: #3c0091;\n  --color-primary-container: #a078ff;\n  --color-secondary-emerald: #4edea3;\n  --color-secondary-dark: #003824;\n  --color-obsidian-base: #0b0b0b;\n  --color-obsidian-surface: #131313;\n  --color-obsidian-container-low: #1c1b1b;\n  --color-obsidian-container-high: #2a2a2a;\n  --color-obsidian-container-highest: #353534;\n  --color-obsidian-on-surface: #e5e2e1;\n  --color-obsidian-on-surface-variant: #cbc3d7;\n}\n\n@layer base {\n  body {\n    background-color: var(--color-obsidian-base);\n    color: var(--color-obsidian-on-surface);\n    font-family: var(--font-sans);\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n  }\n}\n\n/* Custom styles for extreme premium audio brand layout */\n.glass-panel {\n  background: rgba(255, 255, 255, 0.03);\n  backdrop-filter: blur(32px);\n  -webkit-backdrop-filter: blur(32px);\n  border: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.glass-morphism {\n  background: rgba(255, 255, 255, 0.04);\n  backdrop-filter: blur(40px);\n  -webkit-backdrop-filter: blur(40px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.lyrics-gradient {\n  mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 85%, transparent 100%);\n  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 85%, transparent 100%);\n}\n\n.custom-scrollbar::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: #2a2a2a;\n  border-radius: 10px;\n}\n\n.custom-scrollbar::-webkit-scrollbar-thumb:hover {\n  background: #353534;\n}\n\n.primary-glow {\n  box-shadow: 0 0 25px rgba(208, 188, 255, 0.15);\n}\n\n.emerald-glow {\n  box-shadow: 0 0 25px rgba(78, 222, 163, 0.15);\n}\n\n/* Animations */\n@keyframes breathing-mesh {\n  0%, 100% {\n    transform: scale(1) translate(0px, 0px);\n    opacity: 0.12;\n  }\n  33% {\n    transform: scale(1.15) translate(30px, -20px);\n    opacity: 0.22;\n  }\n  66% {\n    transform: scale(0.9) translate(-20px, 40px);\n    opacity: 0.15;\n  }\n}\n\n.animate-breathing {\n  animation: breathing-mesh 10s ease-in-out infinite;\n}\n\n/* Smooth selection overlay */\n::selection {\n  background-color: var(--color-primary-electric);\n  color: var(--color-primary-dark);\n}\n"
