      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useEffect, useRef, useState } from \'react\';\nimport { \n  ChevronDown, \n  Share2, \n  Volume2, \n  VolumeX, \n  ListMusic, \n  Maximize2, \n  LayoutList,\n  Heart,\n  MoreHorizontal,\n  Play,\n  Pause,\n  Disc,\n  X,\n  Sparkles\n} from \'lucide-react\';\nimport { Song } from \'../types\';\nimport { mockSongs } from \'../data\';\n\ninterface NowPlayingViewProps {\n  currentSong: Song;\n  isPlaying: boolean;\n  onTogglePlay: () => void;\n  progress: number;\n  likedSongIds: string[];\n  onToggleLike: (songId: string) => void;\n  onClose: () => void;\n  playQueue: Song[];\n  onPlaySong: (song: Song) => void;\n}\n\nexport default function NowPlayingView({\n  currentSong,\n  isPlaying,\n  onTogglePlay,\n  progress,\n  likedSongIds,\n  onToggleLike,\n  onClose,\n  playQueue,\n  onPlaySong\n}: NowPlayingViewProps) {\n  const canvasRef = useRef<HTMLCanvasElement>(null);\n  const scrollContainerRef = useRef<HTMLDivElement>(null);\n  const [activeLyricIndex, setActiveLyricIndex] = useState(0);\n\n  const isLiked = likedSongIds.includes(currentSong.id);\n\n  // Sync lyrics highlight state dynamically based on progress\n  useEffect(() => {\n    const totalDurationSec = currentSong.durationSec;\n    const totalLyrics = currentSong.lyrics.length;\n    if (totalLyrics > 1) {\n      const secPerLyric = totalDurationSec / totalLyrics;\n      const index = Math.min(totalLyrics - 1, Math.floor(progress / secPerLyric));\n      setActiveLyricIndex(index);\n    }\n  }, [progress, currentSong]);\n\n  // Handle visualizer oscillating sine waves drawn dynamically on canvas\n  useEffect(() => {\n    const canvas = canvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    let rAFId: number;\n    let phase = 0;\n\n    const render = () => {\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      const width = canvas.width;\n      const height = canvas.height;\n      const midY = height / 2;\n\n      // Draw beautiful deep charcoal background mesh\n      ctx.fillStyle = \'#131313\';\n      ctx.fillRect(0, 0, width, height);\n\n      // Waves configuration\n      const waves = [\n        { amplitude: isPlaying ? 35 : 5, freq: 0.015, color: \'rgba(208, 188, 255, 0.4)\', speed: 0.05 },\n        { amplitude: isPlaying ? 22 : 3, freq: 0.03, color: \'rgba(78, 222, 163, 0.5)\', speed: -0.07 },\n        { amplitude: isPlaying ? 12 : 1.5, freq: 0.008, color: \'rgba(255, 255, 255, 0.2)\', speed: 0.03 }\n      ];\n\n      waves.forEach(wave => {\n        ctx.beginPath();\n        ctx.strokeStyle = wave.color;\n        ctx.lineWidth = 1.5;\n\n        for (let x = 0; x < width; x += 1) {\n          const y = midY + Math.sin(x * wave.freq + phase * wave.speed) * wave.amplitude * Math.sin(x * Math.PI / width);\n          if (x === 0) {\n            ctx.moveTo(x, y);\n          } else {\n            ctx.lineTo(x, y);\n          }\n        }\n        ctx.stroke();\n      });\n\n      // Render floating digital equalizer particles\n      for (let i = 0; i < 15; i++) {\n        const xPos = (width / 16) * i + (width / 32) * Math.sin(phase * 0.01 + i);\n        const barHeight = isPlaying \n          ? (Math.abs(Math.sin(phase * 0.05 + i)) * (midY - 10) + 5)\n          : (Math.abs(Math.sin(i * 12)) * 10 + 2);\n\n        ctx.fillStyle = i % 2 === 0 ? \'rgba(208, 188, 255, 0.25)\' : \'rgba(78, 222, 163, 0.25)\';\n        ctx.fillRect(xPos - 3, midY - barHeight / 2, 6, barHeight);\n      }\n\n      phase += 1;\n      rAFId = requestAnimationFrame(render);\n    };\n\n    render();\n    return () => cancelAnimationFrame(rAFId);\n  }, [isPlaying]);\n\n  return (\n    <div className=\"fixed inset-0 bg-obsidian-base min-h-screen z-50 overflow-y-auto py-8 px-12 md:py-12 md:px-20 animate-fade-in flex flex-col justify-between select-none\">\n      \n      {/* 1. Header Toolbar */}\n      <div className=\"flex items-center justify-between\">\n        <button \n          onClick={onClose}\n          className=\"w-11 h-11 bg-obsidian-container-high hover:bg-obsidian-container-highest text-white rounded-full flex items-center justify-center transition-all cursor-pointer shadow-md border border-white/5\"\n        >\n          <ChevronDown className=\"w-5 h-5\" />\n        </button>\n\n        <div className=\"text-center\">\n          <p className=\"text-[10px] font-bold text-primary-electric uppercase tracking-widest leading-4 mb-0.5\">\n            NOW PLAYING\n          </p>\n          <h3 className=\"font-display text-sm font-semibold text-white/50\">\n            {currentSong.album}\n          </h3>\n        </div>\n\n        <button \n          onClick={onClose}\n          className=\"w-11 h-11 bg-obsidian-container-high hover:bg-obsidian-container-highest text-white rounded-full flex items-center justify-center transition-all cursor-pointer shadow-md border border-white/5\"\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n      </div>\n\n      {/* 2. Main High Fidelity Showcase Splitted columns */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 my-8 items-center flex-1\">\n        \n        {/* Left segment showing spinning Cover, Meta, and wave visualizer (5 columns) */}\n        <div className=\"lg:col-span-5 flex flex-col items-center select-none space-y-6\">\n          <div className=\"relative group w-72 h-72 md:w-80 md:h-80 rounded-2xl overflow-hidden shadow-2xl border border-white/10 flex-shrink-0 animate-pulse-subtle\">\n            <img \n              alt={currentSong.title} \n              className={`w-full h-full object-cover transition-transform duration-1000 ${\n                isPlaying ? \'animate-spin-slow scale-102\' : \'scale-100\'\n              }`}\n              src={currentSong.coverUrl}\n            />\n          </div>\n\n          <div className=\"text-center w-full max-w-sm\">\n            <h1 className=\"font-display text-2xl md:text-3xl font-extrabold text-white tracking-tight leading-snug\">\n              {currentSong.title}\n            </h1>\n            <p className=\"font-sans text-sm text-primary-electric/80 font-medium mt-1\">\n              {currentSong.artist}\n            </p>\n          </div>\n\n          {/* Interactive Visualizer Node Canvas satisfying data visualization parameters */}\n          <div className=\"w-full h-32 rounded-2xl overflow-hidden relative shadow border border-white/5 bg-obsidian-surface max-w-sm\">\n            <canvas \n              ref={canvasRef} \n              width={380} \n              height={128} \n              className=\"w-full h-full\"\n            />\n            <div className=\"absolute top-2.5 right-3.5 flex items-center gap-1\">\n              <Sparkles className=\"w-3.5 h-3.5 text-secondary-emerald animate-pulse\" />\n              <span className=\"text-[9px] font-mono font-bold tracking-wider text-secondary-emerald uppercase\">HI-RES AUDIO</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Center / Right lyrics scroller element (7 columns) */}\n        <div className=\"lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-8 h-full items-stretch min-h-[400px]\">\n          \n          {/* Synchronized Live Lyrics Box */}\n          <div className=\"bg-obsidian-container-low/40 border border-white/5 p-6 md:p-8 rounded-3xl flex flex-col justify-center min-h-[300px]\">\n            <h4 className=\"text-[10px] font-bold text-obsidian-on-surface-variant/40 tracking-widest uppercase mb-4 pl-1 flex items-center gap-2\">\n              <Disc className=\"w-3.5 h-3.5 text-primary-electric\" />\n              <span>Real-Time Lyrics</span>\n            </h4>\n            \n            <div className=\"flex-1 overflow-y-auto custom-scrollbar pr-2 h-72 space-y-5 lyrics-gradient\">\n              {currentSong.lyrics.map((lyric, idx) => {\n                const isActive = idx === activeLyricIndex;\n                const isPast = idx < activeLyricIndex;\n                return (\n                  <p \n                    key={idx}\n                    className={`font-sans font-bold text-sm md:text-base leading-relaxed tracking-tight transition-all duration-300 ${\n                      isActive \n                        ? \'text-primary-electric scale-102 font-extrabold pr-2 filter drop-shadow-[0_0_8px_rgba(208,188,255,0.3)]\' \n                        : isPast \n                          ? \'text-white/30 font-medium\' \n                          : \'text-white/50 font-semibold\'\n                    }`}\n                  >\n                    {lyric}\n                  </p>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Up Next / Play Queue side pane */}\n          <div className=\"bg-obsidian-container-low/40 border border-white/5 p-6 md:p-8 rounded-3xl flex flex-col\">\n            <h4 className=\"text-[10px] font-bold text-obsidian-on-surface-variant/40 tracking-widest uppercase mb-4 flex items-center gap-2\">\n              <ListMusic className=\"w-3.5 h-3.5 text-secondary-emerald\" />\n              <span>Up Next Session</span>\n            </h4>\n            \n            <div className=\"flex-1 space-y-3 overflow-y-auto custom-scrollbar pr-2 h-72\">\n              {mockSongs.slice(0, 4).map((song) => {\n                const isCurrent = song.id === currentSong.id;\n                return (\n                  <div\n                    key={song.id}\n                    onClick={() => onPlaySong(song)}\n                    className={`flex items-center gap-3 p-2.5 rounded-xl transition-all cursor-pointer ${\n                      isCurrent \n                        ? \'bg-primary-electric/10 border border-primary-electric/20\' \n                        : \'hover:bg-white/5\'\n                    }`}\n                  >\n                    <img \n                      alt={song.title} \n                      className=\"w-10 h-10 rounded object-cover shadow\"\n                      src={song.coverUrl}\n                    />\n                    <div className=\"overflow-hidden flex-1 select-none\">\n                      <p className={`text-xs font-bold truncate leading-snug ${isCurrent ? \'text-primary-electric\' : \'text-white\'}`}>\n                        {song.title}\n                      </p>\n                      <p className=\"text-[10px] text-obsidian-on-surface-variant/40 truncate\">\n                        {song.artist}\n                      </p>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n      {/* 3. Dynamic Console Drawer footer */}\n      <div className=\"pt-6 border-t border-white/5 flex flex-col md:flex-row items-center justify-between gap-6\">\n        <div className=\"flex items-center gap-4\">\n          <button \n            onClick={() => onToggleLike(currentSong.id)}\n            className=\"text-obsidian-on-surface-variant/60 hover:text-primary-electric transition-transform hover:scale-110 cursor-pointer\"\n          >\n            <Heart className={`w-5 h-5 ${isLiked ? \'text-primary-electric fill-primary-electric\' : \'\'}`} />\n          </button>\n          <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono font-bold uppercase\">\n            {currentSong.genre}\n          </span>\n        </div>\n\n        {/* Central visual cue play console */}\n        <button \n          onClick={onTogglePlay}\n          className=\"w-14 h-14 bg-white hover:bg-primary-electric text-black rounded-full flex items-center justify-center shadow-lg transition-all hover:scale-110 active:scale-95 cursor-pointer\"\n        >\n          {isPlaying ? (\n            <Pause className=\"w-6 h-6 fill-current\" />\n          ) : (\n            <Play className=\"w-6 h-6 fill-current translate-x-0.5\" />\n          )}\n        </button>\n\n        <div className=\"flex items-center gap-4\">\n          <Share2 className=\"w-4.5 h-4.5 text-obsidian-on-surface-variant/50 hover:text-white cursor-pointer\" />\n          <Maximize2 className=\"w-4 h-4 text-obsidian-on-surface-variant/50 hover:text-white cursor-pointer\" />\n        </div>\n      </div>\n\n    </div>\n  );\n}\n"
    }
