  file_change {
    absolute_path_uri: "file:///src/components/AnalyticsView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useEffect, useState } from \'react\';\nimport { \n  ResponsiveContainer, \n  AreaChart, \n  Area, \n  XAxis, \n  YAxis, \n  Tooltip, \n  PieChart, \n  Pie, \n  Cell, \n  BarChart, \n  Bar, \n  Legend \n} from \'recharts\';\nimport { \n  Activity, \n  Compass, \n  Volume2, \n  Cpu, \n  TrendingUp, \n  CheckCircle2, \n  Flame, \n  Music,\n  LineChart,\n  PieChart as PieIcon\n} from \'lucide-react\';\nimport { Song } from \'../types\';\nimport { staticHabitsData, genreBreakdown } from \'../data\';\n\ninterface AnalyticsViewProps {\n  currentSong: Song;\n  isPlaying: boolean;\n}\n\nexport default function AnalyticsView({ currentSong, isPlaying }: AnalyticsViewProps) {\n  // Real-time ticking values\n  const [liveBitrate, setLiveBitrate] = useState(320);\n  const [liveDB, setLiveDB] = useState(55);\n  const [bufferStatus, setBufferStatus] = useState(99.2);\n  const [packetHealth, setPacketHealth] = useState(100);\n\n  useEffect(() => {\n    // Continuous dynamic tick simulation representing alive server nodes\n    const timer = setInterval(() => {\n      if (isPlaying) {\n        setLiveBitrate(prev => {\n          const change = Math.random() > 0.5 ? 4 : -4;\n          return Math.max(940, Math.min(990, prev === 320 ? 960 : prev + change));\n        });\n        setLiveDB(prev => {\n          const change = Math.floor(Math.random() * 8) - 4;\n          return Math.max(50, Math.min(82, prev + change));\n        });\n        setBufferStatus(prev => Math.max(98.5, Math.min(100, prev + (Math.random() * 0.2 - 0.1))));\n        setPacketHealth(prev => Math.max(99.8, Math.min(100, prev + (Math.random() * 0.1 - 0.05))));\n      } else {\n        setLiveBitrate(128); // Standard Idle Standby Compression\n        setLiveDB(0); // Silent room index\n        setBufferStatus(100);\n        setPacketHealth(100);\n      }\n    }, 1200);\n\n    return () => clearInterval(timer);\n  }, [isPlaying]);\n\n  return (\n    <div className=\"space-y-8 animate-fade-in pr-2 select-none\">\n      \n      {/* 1. Header Hero Segment */}\n      <section className=\"flex flex-col md:flex-row md:items-center justify-between pb-4 border-b border-[#ffffff]/5\">\n        <div>\n          <h2 className=\"font-display text-3xl font-extrabold text-white tracking-tight flex items-center gap-3\">\n            <Activity className=\"w-8 h-8 text-secondary-emerald animate-pulse\" />\n            <span>Hi-Fi Audio Analytics</span>\n          </h2>\n          <p className=\"text-xs text-obsidian-on-surface-variant/40 mt-1 font-medium font-sans\">\n            Real-time lossy stream telemetry and user acoustic habits\n          </p>\n        </div>\n        \n        <div className=\"bg-obsidian-container-low border border-white/5 px-4 py-2.5 rounded-full flex items-center gap-2 mt-4 md:mt-0\">\n          <span className=\"w-2.5 h-2.5 bg-secondary-emerald rounded-full animate-ping\" />\n          <span className=\"text-[10px] font-mono font-bold text-secondary-emerald uppercase tracking-wider\">\n            LIVE BITRATE: {liveBitrate} KBPS FLAC\n          </span>\n        </div>\n      </section>\n\n      {/* 2. Grid metrics highlights of current track */}\n      <section className=\"grid grid-cols-2 lg:grid-cols-4 gap-6\">\n        \n        {/* Bitrate Card */}\n        <div className=\"bg-obsidian-container-low p-5 rounded-2xl border border-white/5 relative overflow-hidden group\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-obsidian-on-surface-variant/40\">\n              Compression Ratio\n            </span>\n            <Cpu className=\"w-4 h-4 text-primary-electric\" />\n          </div>\n          <div className=\"mt-4 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-extrabold text-white tracking-tight font-display\">\n              {liveBitrate}\n            </span>\n            <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono\">kbps</span>\n          </div>\n          <p className=\"text-[10px] text-primary-electric/75 mt-2 font-medium\">\n            {isPlaying ? \'Lossless audio decompression\' : \'Telemetry standby Mode\'}\n          </p>\n        </div>\n\n        {/* Dynamic Decibel Card */}\n        <div className=\"bg-obsidian-container-low p-5 rounded-2xl border border-white/5 relative overflow-hidden group\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-obsidian-on-surface-variant/40\">\n              Acoustic Amplitude\n            </span>\n            <Volume2 className=\"w-4 h-4 text-secondary-emerald\" />\n          </div>\n          <div className=\"mt-4 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-extrabold text-white tracking-tight font-display\">\n              {liveDB}\n            </span>\n            <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono\">dB ESP</span>\n          </div>\n          <p className=\"text-[10px] text-secondary-emerald/75 mt-2 font-medium\">\n            {isPlaying ? \'Active speaker safe limit feedback\' : \'No signal registered\'}\n          </p>\n        </div>\n\n        {/* Buffer Health */}\n        <div className=\"bg-obsidian-container-low p-5 rounded-2xl border border-white/5 relative overflow-hidden group\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-obsidian-on-surface-variant/40\">\n              Buffer Cache Hit\n            </span>\n            <CheckCircle2 className=\"w-4 h-4 text-amber-300\" />\n          </div>\n          <div className=\"mt-4 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-extrabold text-white tracking-tight font-display\">\n              {bufferStatus.toFixed(2)}\n            </span>\n            <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono\">%</span>\n          </div>\n          <p className=\"text-[10px] text-amber-300/75 mt-2 font-medium\">\n            Dynamic cache pre-allocation active\n          </p>\n        </div>\n\n        {/* Stream Node Node Delay */}\n        <div className=\"bg-obsidian-container-low p-5 rounded-2xl border border-white/5 relative overflow-hidden group\">\n          <div className=\"flex items-center justify-between\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-obsidian-on-surface-variant/40\">\n              Ping Latency\n            </span>\n            <Flame className=\"w-4 h-4 text-red-400\" />\n          </div>\n          <div className=\"mt-4 flex items-baseline gap-2\">\n            <span className=\"text-3xl font-extrabold text-white tracking-tight font-display\">\n              {isPlaying ? \'1.4\' : \'0.0\'}\n            </span>\n            <span className=\"text-xs text-obsidian-on-surface-variant/40 font-mono\">ms</span>\n          </div>\n          <p className=\"text-[10px] text-red-400/75 mt-2 font-medium\">\n            Cloud Run container ingress delay\n          </p>\n        </div>\n\n      </section>\n\n      {/* 3. Recharts Area Chart and Pie Chart side-by-side */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\">\n        \n        {/* Weekly Habits Chart (7 columns) */}\n        <div className=\"lg:col-span-8 bg-obsidian-container-low p-6 rounded-3xl border border-white/5\">\n          <div className=\"flex items-center justify-between mb-6\">\n            <div className=\"flex items-center gap-2\">\n              <LineChart className=\"w-5 h-5 text-primary-electric\" />\n              <h3 className=\"font-display text-lg font-bold text-white tracking-tight\">\n                Your Streaming Habits\n              </h3>\n            </div>\n            <span className=\"text-[10px] font-bold text-obsidian-on-surface-variant/40 tracking-wider\">\n              PAST 7 DAYS SUMMARY\n            </span>\n          </div>\n\n          <div className=\"h-72\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={staticHabitsData} margin={{ top: 10, right: 10, left: -25, bottom: 0 }}>\n                <defs>\n                  <linearGradient id=\"hoursGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#d0bcff\" stopOpacity={0.4} />\n                    <stop offset=\"95%\" stopColor=\"#d0bcff\" stopOpacity={0.0} />\n                  </linearGradient>\n                  <linearGradient id=\"dbGrad\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#4edea3\" stopOpacity={0.3} />\n                    <stop offset=\"95%\" stopColor=\"#4edea3\" stopOpacity={0.0} />\n                  </linearGradient>\n                </defs>\n                <XAxis \n                  dataKey=\"day\" \n                  stroke=\"#cbc3d7\" \n                  fontSize={10} \n                  tickLine={false} \n                  axisLine={false} \n                  style={{ opacity: 0.5 }}\n                />\n                <YAxis \n                  stroke=\"#cbc3d7\" \n                  fontSize={10} \n                  tickLine={false} \n                  axisLine={false} \n                  style={{ opacity: 0.5 }}\n                />\n                <Tooltip \n                  contentStyle={{ \n                    backgroundColor: \'#1c1b1b\', \n                    borderRadius: \'12px\', \n                    border: \'1px solid rgba(255,255,255,0.08)\',\n                    color: \'#fff\',\n                    fontFamily: \'Inter\',\n                    fontSize: \'11px\'\n                  }} \n                />\n                <Area \n                  type=\"monotone\" \n                  dataKey=\"hours\" \n                  name=\"Hours Listened\"\n                  stroke=\"#d0bcff\" \n                  strokeWidth={2.5}\n                  fillOpacity={1} \n                  fill=\"url(#hoursGrad)\" \n                />\n                <Area \n                  type=\"monotone\" \n                  dataKey=\"decibels\" \n                  name=\"Average Volume (dB)\" \n                  stroke=\"#4edea3\" \n                  strokeWidth={1.5}\n                  fillOpacity={1} \n                  fill=\"url(#dbGrad)\" \n                  strokeDasharray=\"4 4\"\n                />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </div>\n\n        {/* Genres Pie Breakdown (4 columns) */}\n        <div className=\"lg:col-span-4 bg-obsidian-container-low p-6 rounded-3xl border border-white/5 flex flex-col justify-between\">\n          <div className=\"flex items-center gap-2 mb-4\">\n            <PieIcon className=\"w-5 h-5 text-secondary-emerald\" />\n            <h3 className=\"font-display text-lg font-bold text-white tracking-tight\">\n              Acoustic Profile\n            </h3>\n          </div>\n\n          <div className=\"h-48 relative flex items-center justify-center\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <PieChart>\n                <Pie\n                  data={genreBreakdown}\n                  cx=\"50%\"\n                  cy=\"50%\"\n                  innerRadius={55}\n                  outerRadius={75}\n                  paddingAngle={4}\n                  dataKey=\"value\"\n                >\n                  {genreBreakdown.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.color} />\n                  ))}\n                </Pie>\n                <Tooltip \n                  contentStyle={{ \n                    backgroundColor: \'#1c1b1b\', \n                    borderRadius: \'12px\', \n                    border: \'1px solid rgba(255,255,255,0.08)\',\n                    color: \'#fff\',\n                    fontFamily: \'Inter\',\n                    fontSize: \'11px\'\n                  }} \n                />\n              </PieChart>\n            </ResponsiveContainer>\n            {/* Center title labels */}\n            <div className=\"absolute flex flex-col items-center\">\n              <span className=\"text-[10px] font-mono text-obsidian-on-surface-variant/40 uppercase tracking-widest font-bold\">\n                TOP GENRE\n              </span>\n              <span className=\"text-white text-xs font-bold font-sans mt-0.5\">\n                Synthwave\n              </span>\n            </div>\n          </div>\n\n          {/* Table Labels breakdown */}\n          <div className=\"mt-4 space-y-1.5 flex-1 overflow-y-auto\">\n            {genreBreakdown.map((item, id) => (\n              <div key={id} className=\"flex items-center justify-between text-xs\">\n                <div className=\"flex items-center gap-2.5\">\n                  <div style={{ backgroundColor: item.color }} className=\"w-2.5 h-2.5 rounded-full\" />\n                  <span className=\"text-obsidian-on-surface-variant/80 font-medium font-sans\">\n                    {item.name}\n                  </span>\n                </div>\n                <span className=\"text-white font-mono font-bold\">\n                  {item.value}%\n                </span>\n              </div>\n            ))}\n          </div>\n\n        </div>\n\n      </section>\n\n    </div>\n  );\n}\n"
    }
