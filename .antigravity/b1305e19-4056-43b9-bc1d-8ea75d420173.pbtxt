g-obsidian-container-high text-obsidian-on-surface-variant/70 hover:text-obsidian-on-surface transition-all cursor-pointer border border-[#ffffff]/5\"\n        >\n          {isDarkMode ? <Sun className=\"w-4 h-4 text-amber-300\" /> : <Moon className=\"w-4 h-4 text-[#a078ff]\" />}\n        </button>\n\n        {/* Settings button */}\n        <button \n          onClick={onOpenSettings}\n          className=\"w-10 h-10 flex items-center justify-center rounded-full bg-obsidian-container-high/40 hover:bg-obsidian-container-high text-obsidian-on-surface-variant/70 hover:text-obsidian-on-surface transition-all cursor-pointer border border-[#ffffff]/5\"\n          title=\"Streaming Settings\"\n        >\n          <Settings className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </header>\n  );\n}"
