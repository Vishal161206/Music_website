    replacement_infos {
      original_chunk {
        target_content: "export default function Header({\n  activeScreen,\n  setActiveScreen,\n  searchQuery,\n  setSearchQuery,\n  isDarkMode,\n  setIsDarkMode,\n  onOpenNotifications,\n  onOpenSettings\n}: HeaderProps) {\n  return (\n    <header className=\"fixed top-0 right-0 w-[calc(100%-280px)] h-16 bg-obsidian-surface/80 backdrop-blur-3xl flex items-center justify-between px-8 z-40 border-b border-[#ffffff]/5 select-none transition-all\">\n      {/* Navigation & Search Area */}\n      <div className=\"flex items-center gap-6 flex-1 max-w-2xl\">\n        {/* Navigation Arrows */}\n        <div className=\"flex items-center gap-2\">\n          <button \n            onClick={() => setActiveScreen(\'home\')}\n            className=\"w-8 h-8 rounded-full bg-obsidian-container-low hover:bg-obsidian-container-high flex items-center justify-center text-white/50 hover:text-white transition-all cursor-pointer border border-[#ffffff]/5\"\n          >\n            <ChevronLeft className=\"w-4 h-4\" />\n          </button>\n          <button \n            onClick={() => setActiveScreen(\'library\')}\n            className=\"w-8 h-8 rounded-full bg-obsidian-container-low hover:bg-obsidian-container-high flex items-center justify-center text-white/50 hover:text-white transition-all cursor-pointer border border-[#ffffff]/5\"\n          >\n            <ChevronRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Global Search Bar */}\n        <div className=\"relative w-full max-w-sm\">\n          <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-obsidian-on-surface-variant/40 w-4 h-4\" />\n          <input\n            id=\"searchInput\"\n            type=\"text\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full bg-obsidian-container-high border-none text-white text-sm rounded-full py-2 pl-10 pr-4 placeholder:text-obsidian-on-surface-variant/40 focus:ring-1 focus:ring-primary-electric focus:bg-obsidian-container-highest transition-all outline-none\"\n            placeholder=\"Artists, songs, or podcasts\"\n          />\n        </div>\n\n        {/* Direct Tags Shortcut */}\n        <div className=\"hidden lg:flex items-center gap-4 text-xs font-sans font-medium text-obsidian-on-surface-variant/60\">\n          <button\n            onClick={() => setActiveScreen(\'home\')}\n            className={`cursor-pointer transition-all hover:text-primary-electric ${\n              activeScreen === \'home\' ? \'text-primary-electric font-semibold border-b-2 border-primary-electric py-1\' : \'\'\n            }`}\n          >\n            Music\n          </button>\n          <button\n            onClick={() => setActiveScreen(\'library\')}\n            className={`cursor-pointer transition-all hover:text-primary-electric ${\n              activeScreen === \'library\' ? \'text-primary-electric font-semibold border-b-2 border-primary-electric py-1\' : \'\'\n            }`}\n          >\n            Podcasts\n          </button>\n          <button\n            onClick={() => setActiveScreen(\'analytics\')}\n            className={`cursor-pointer transition-all hover:text-secondary-emerald ${\n              activeScreen === \'analytics\' ? \'text-secondary-emerald font-semibold border-b-2 border-secondary-emerald py-1\' : \'\'\n            }`}\n          >\n            Audio Analytics\n          </button>\n        </div>\n      </div>\n\n      {/* Control Actions & User Accent */}\n      <div className=\"flex items-center gap-4\">\n        {/* Real-time Theme Toggler for Accessibility */}\n        <button\n          onClick={() => setIsDarkMode(!isDarkMode)}\n          title={isDarkMode ? \'Toggle Light Mode\' : \'Toggle Dark Mode\'}\n          className=\"w-10 h-10 flex items-center justify-center rounded-full bg-obsidian-container-high/40 hover:bg-obsidian-container-high text-obsidian-on-surface-variant/70 hover:text-white transition-all cursor-pointer border border-[#ffffff]/5\"\n        >\n          {isDarkMode ? <Sun className=\"w-4 h-4 text-amber-300\" /> : <Moon className=\"w-4 h-4 text-[#a078ff]\" />}\n        </button>\n\n        {/* Notifications and Settings buttons */}\n        <button \n          onClick={onOpenNotifications}\n          className=\"w-10 h-10 flex items-center justify-center rounded-full bg-obsidian-container-high/40 hover:bg-obsidian-container-high text-obsidian-on-surface-variant/70 hover:text-white transition-all cursor-pointer border border-[#ffffff]/5\"\n        >\n          <Bell className=\"w-4 h-4\" />\n        </button>\n\n        <button \n          onClick={onOpenSettings}\n          className=\"w-10 h-10 flex items-center justify-center rounded-full bg-obsidian-container-high/40 hover:bg-obsidian-container-high text-obsidian-on-surface-variant/70 hover:text-white transition-all cursor-pointer border border-[#ffffff]/5\"\n        >\n          <Settings className=\"w-4 h-4\" />\n        </button>\n\n        {/* Premium Persona Avatar */}\n        <div \n          onClick={() => setActiveScreen(\'analytics\')}\n          className=\"w-9 h-9 rounded-full overflow-hidden border border-primary-electric/20 ml-2 hover:border-primary-electric hover:scale-105 transition-all cursor-pointer shadow-md\"\n          title=\"View Listener Stats\"\n        >\n          <img \n            alt=\"User Profile\" \n            className=\"w-full h-full object-cover\"\n            src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuADHBxoTS-HqyiBRU5EiST08VkDhvVbqUcCMAh9wWUzxCmDVTWUSnCH-GecxPZgr06Wc_-PefhWRJtCh4IxkkGLVe7j07DG270T0zs0Ng4thnUR-72nRf9tLjLBKz3J1qB0dozYtypwWoIvivas-1xPvhVAs-cPfV_2XCdGWNQte_NqGCc5FKg-1LiyHZc44nEPHT7qhXdSicvLcvhnJevV2h6hJLy8xPcgoSpEoU8vLQ05n_DxNiingiQFTq2eHXH2nDRJteET1V8\"\n          />\n        </div>\n      </div>\n    </header>\n  );\n}"
