  file_change {
    absolute_path_uri: "file:///src/components/HomeView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useEffect, useState } from \'react\';\nimport { Play, Plus, Check, Star, Users, Music, PlusSquare } from \'lucide-react\';\nimport { Song, Playlist } from \'../types\';\n\ninterface HomeViewProps {\n  songs: Song[];\n  onPlaySong: (song: Song) => void;\n  onPlayPlaylist: (playlist: Playlist) => void;\n  activeSongId: string;\n  playlists: Playlist[];\n  onViewPlaylist: (playlist: Playlist) => void;\n  onOpenCreatePlaylist: () => void;\n}\n\nexport default function HomeView({\n  songs,\n  onPlaySong,\n  onPlayPlaylist,\n  activeSongId,\n  playlists,\n  onViewPlaylist,\n  onOpenCreatePlaylist\n}: HomeViewProps) {\n  const [visualizerHeights, setVisualizerHeights] = useState<number[]>([40, 70, 50, 90, 30, 80, 45, 60, 35, 75, 55, 95]);\n\n  // Simulate active decorative graphic visualizer\n  useEffect(() => {\n    const handleInterval = setInterval(() => {\n      setVisualizerHeights(prev => prev.map(() => Math.floor(Math.random() * 75) + 25));\n    }, 150);\n    return () => clearInterval(handleInterval);\n  }, []);\n\n  // Filter songs that appear in recently played dynamically from our library\n  const recentlyPlayedSongs = songs.slice(0, 6);\n\n  // Fallback / temporary playlist in case they are empty, but otherwise we rely on user playlists\n  const showBannerPlaylist = playlists.length > 0 ? playlists[0] : null;\n\n  return (\n    <div className=\"space-y-10 animate-fade-in p-2\">\n      {/* Hero Banner: Made For You */}\n      <section className=\"relative h-[380px] rounded-3xl overflow-hidden group border border-[#ffffff]/5 shadow-2xl bg-obsidian-surface\">\n        <div className=\"absolute inset-0 z-0\">\n          <img \n            className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" \n            alt=\"Warm glowing audiophile ambient waves\" \n            src=\"https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?q=80&w=1200\"\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-obsidian-base via-black/40 to-black/25\" />\n          <div className=\"absolute inset-0 bg-gradient-to-r from-obsidian-base/80 via-black/50 to-transparent\" />\n        </div>\n        \n        <div className=\"relative z-10 h-full flex flex-col justify-end p-8 md:p-12 max-w-2xl select-none\">\n          <div className=\"flex items-center gap-3 mb-4\">\n            <span className=\"bg-primary-electric/20 text-primary-electric px-3.5 py-1 rounded-full text-[10px] font-bold tracking-widest backdrop-blur-md border border-primary-electric/25\">\n              COMMON PUBLIC STREAM\n            </span>\n            {/* Visualizer bars */}\n            <div className=\"flex items-end gap-[3px] h-4\">\n              {visualizerHeights.map((h, i) => (\n                <div \n                  key={i} \n                  style={{ height: `${h}%` }}\n                  className=\"w-1.5 bg-gradient-to-t from-primary-electric to-secondary-emerald rounded-full transition-all duration-150\"\n                />\n              ))}\n            </div>\n          </div>\n          \n          <h2 className=\"font-display text-4xl md:text-5xl font-extrabold mb-3 leading-none tracking-tighter text-white\">\n            Common Sharing Hub\n          </h2>\n          <p className=\"text-sm font-sans text-white/85 mb-6 max-w-lg leading-relaxed\">\n            Upload songs from your device and group them into public custom compilation playlists. No membership or lockouts required!\n          </p>\n          \n          <div className=\"flex items-center gap-4\">\n            {showBannerPlaylist ? (\n              <>\n                <button \n                  onClick={() => onPlayPlaylist(showBannerPlaylist)}\n                  className=\"bg-primary-electric text-black px-8 py-3.5 rounded-full text-xs font-bold flex items-center gap-2 hover:scale-105 active:scale-95 transition-transform primary-glow cursor-pointer\"\n                >\n                  <Play className=\"w-4.5 h-4.5 fill-current text-black\" />\n                  <span>Play {showBannerPlaylist.name}</span>\n                </button>\n                <button \n                  onClick={() => onViewPlaylist(showBannerPlaylist)}\n                  className=\"border border-[#ffffff]/20 hover:bg-[#ffffff]/10 text-white px-8 py-3.5 rounded-full text-xs font-bold backdrop-blur-md transition-all cursor-pointer\"\n                >\n                  View Playlist Detail\n                </button>\n              </>\n            ) : (\n              <button \n                onClick={onOpenCreatePlaylist}\n                className=\"bg-primary-electric text-black px-8 py-3.5 rounded-full text-xs font-bold flex items-center gap-2 hover:scale-105 active:scale-95 transition-transform primary-glow cursor-pointer\"\n              >\n                <PlusSquare className=\"w-4.5 h-4.5\" />\n                <span>Create Your First Playlist</span>\n              </button>\n            )}\n          </div>\n        </div>\n      </section>\n\n      {/* Recently Played Bento Grid */}\n      <section>\n        <div className=\"flex items-center justify-between mb-6\">\n          <h3 className=\"font-display text-2xl font-bold text-obsidian-on-surface tracking-tight\">\n            Available Website Tracks\n          </h3>\n          <span className=\"text-xs font-semibold text-primary-electric uppercase\">\n            {songs.length} Dynamic Chords Loaded\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6\">\n          {recentlyPlayedSongs.map((song) => {\n            const isActive = activeSongId === song.id;\n            return (\n              <div \n                key={song.id}\n                onClick={() => onPlaySong(song)}\n                className={`group relative bg-obsidian-container-low p-4 rounded-xl transition-all duration-300 hover:bg-obsidian-container-high hover:scale-[1.02] cursor-pointer shadow-lg border border-[#ffffff]/5 ${\n                  isActive ? \'border-primary-electric/40 primary-glow\' : \'\'\n                }`}\n              >\n                <div className=\"relative aspect-square rounded-lg overflow-hidden mb-4 shadow bg-obsidian-base\">\n                  <img \n                    className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\" \n                    alt={song.title} \n                    src={song.coverUrl}\n                  />\n                  {/* Floating click play overlay */}\n                  <div className=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center animate-fade-in\">\n                    <button className=\"w-12 h-12 bg-primary-electric text-black rounded-full flex items-center justify-center hover:scale-110 active:scale-95 transition-transform primary-glow shadow-lg cursor-pointer\">\n                      <Play className=\"w-5 h-5 fill-current text-black translate-x-0.5\" />\n                    </button>\n                  </div>\n                </div>\n                \n                <h4 className=\"font-sans font-bold text-sm truncate text-obsidian-on-surface\">\n                  {song.title}\n                </h4>\n                <p className=\"font-sans text-xs text-obsidian-on-surface-variant/40 mt-1 truncate\">\n                  {song.artist}\n                </p>\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* Playlists (Asymmetric Layout / Guide if empty) */}\n      <section>\n        <div className=\"flex items-center justify-between mb-6\">\n          <h3 className=\"font-display text-2xl font-bold text-obsidian-on-surface tracking-tight\">\n            Shared Public Playlists\n          </h3>\n        </div>\n\n        {playlists.length === 0 ? (\n          <div className=\"border border-dashed border-zinc-300 dark:border-white/10 rounded-3xl p-8 flex flex-col items-center justify-center text-center space-y-4 bg-obsidian-container-low/40 max-w-2xl mx-auto\">\n            <Music className=\"w-12 h-12 text-primary-electric animate-spin duration-3000\" />\n            <div className=\"space-y-1\">\n              <h5 className=\"font-sans font-bold text-base text-obsidian-on-surface\">\n                No active custom playlists yet\n              </h5>\n              <p className=\"text-xs text-obsidian-on-surface-variant/50 max-w-md\">\n                All initial mock playlists have been removed. Create a new public playlist from the sidebar and add songs dynamically from the available website catalogue!\n              </p>\n            </div>\n            <button\n              onClick={onOpenCreatePlaylist}\n              className=\"py-2.5 px-6 rounded-full bg-primary-electric text-black font-extrabold text-xs hover:scale-105 active:scale-95 transition-transform cursor-pointer\"\n            >\n              + Create Public Playlist\n            </button>\n          </div>\n        ) : (\n          <div className=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6\">\n            {playlists.map((pl) => (\n              <div \n                key={pl.id}\n                onClick={() => onViewPlaylist(pl)}\n                className=\"group p-4 bg-obsidian-container-low hover:bg-obsidian-container-high rounded-2xl border border-white/5 cursor-pointer transition-all flex flex-col\"\n              >\n                <div className=\"relative aspect-square rounded-xl overflow-hidden mb-4 shadow border border-white/5 bg-obsidian-surface\">\n                  <img \n                    alt={pl.name} \n                    className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\" \n                    src={pl.coverUrl}\n                  />\n                  <div className=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center animate-fade-in\">\n                    <button \n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onPlayPlaylist(pl);\n                      }}\n                      className=\"w-12 h-12 bg-primary-electric text-white rounded-full flex items-center justify-center hover:scale-110 active:scale-95 transition-transform shadow-lg cursor-pointer\"\n                    >\n                      <Play className=\"w-5 h-5 fill-current text-black translate-x-0.5\" />\n                    </button>\n                  </div>\n                </div>\n                <h4 className=\"font-sans font-bold text-sm text-obsidian-on-surface group-hover:text-primary-electric truncate\">\n                  {pl.name}\n                </h4>\n                <p className=\"text-xs text-obsidian-on-surface-variant/55 mt-1 font-sans truncate\">\n                  {pl.songIds.length} tracks\n                </p>\n              </div>\n            ))}\n          </div>\n        )}\n      </section>\n    </div>\n  );\n}\n"
    }
