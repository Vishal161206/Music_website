    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useEffect } from \'react\';\nimport { Song, Playlist, ActiveScreen } from \'./types\';\nimport { mockSongs, mockPlaylists } from \'./data\';\nimport Sidebar from \'./components/Sidebar\';\nimport Header from \'./components/Header\';\nimport BottomPlayer from \'./components/BottomPlayer\';\nimport HomeView from \'./components/HomeView\';\nimport LibraryView from \'./components/LibraryView\';\nimport PlaylistDetailView from \'./components/PlaylistDetailView\';\nimport NowPlayingView from \'./components/NowPlayingView\';\nimport AnalyticsView from \'./components/AnalyticsView\';\nimport CreatePlaylistModal from \'./components/CreatePlaylistModal\';\nimport { Sparkles, Check, Info } from \'lucide-react\';\n\nexport default function App() {\n  // Global States\n  const [activeScreen, setActiveScreen] = useState<ActiveScreen>(\'home\');\n  const [currentSong, setCurrentSong] = useState<Song>(mockSongs[0]); // Starts on Midnight Reflections\n  const [isPlaying, setIsPlaying] = useState<boolean>(false);\n  const [progress, setProgress] = useState<number>(0);\n  const [volume, setVolume] = useState<number>(80);\n  const [isMuted, setIsMuted] = useState<boolean>(false);\n  const [isShuffle, setIsShuffle] = useState<boolean>(false);\n  const [isRepeat, setIsRepeat] = useState<boolean>(false);\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  \n  // Custom Library/Playlists state\n  const [playlists, setPlaylists] = useState<Playlist[]>(mockPlaylists);\n  const [selectedPlaylist, setSelectedPlaylist] = useState<Playlist | null>(mockPlaylists[0]);\n  const [likedSongIds, setLikedSongIds] = useState<string[]>([\'6\', \'8\', \'11\']); // Default Liked songs\n  \n  // Active queue management\n  const [playQueue, setPlayQueue] = useState<Song[]>(mockSongs);\n  const [queueIndex, setQueueIndex] = useState<number>(0);\n\n  // Appearance & Accessibility Toggling\n  const [isDarkMode, setIsDarkMode] = useState<boolean>(true);\n\n  // Modal/Notification states\n  const [isCreateModalOpen, setIsCreateModalOpen] = useState(false);\n  const [activeNotification, setActiveNotification] = useState<string | null>(null);\n\n  // Keep track of recently played list\n  const [history, setHistory] = useState<Song[]>([mockSongs[1], mockSongs[2]]);\n\n  // Trigger quick popup toast messages and auto dismiss them\n  const triggerToast = (msg: string) => {\n    setActiveNotification(msg);\n    setTimeout(() => {\n      setActiveNotification(null);\n    }, 3500);\n  };\n\n  // Playback timer ticker increments every 1s\n  useEffect(() => {\n    let timer: NodeJS.Timeout | null = null;\n    if (isPlaying) {\n      timer = setInterval(() => {\n        setProgress(prev => {\n          if (prev >= currentSong.durationSec - 1) {\n            handleAutoNext();\n            return 0;\n          }\n          return prev + 1;\n        });\n      }, 1000);\n    }\n    return () => {\n      if (timer) clearInterval(timer);\n    };\n  }, [isPlaying, currentSong, queueIndex, playQueue]);\n\n  // Handle auto skip track ending\n  const handleAutoNext = () => {\n    if (isRepeat) {\n      setProgress(0);\n      triggerToast(`Repeating: \"${currentSong.title}\"`);\n    } else {\n      skipNext();\n    }\n  };\n\n  // Skip tracks forward\n  const skipNext = () => {\n    if (isShuffle) {\n      const randIndex = Math.floor(Math.random() * playQueue.length);\n      setQueueIndex(randIndex);\n      setCurrentSong(playQueue[randIndex]);\n      setProgress(0);\n      triggerToast(`Shuffled track loaded: \"${playQueue[randIndex].title}\"`);\n    } else {\n      const nextIndex = (queueIndex + 1) % playQueue.length;\n      setQueueIndex(nextIndex);\n      setCurrentSong(playQueue[nextIndex]);\n      setProgress(0);\n      triggerToast(`Playing next: \"${playQueue[nextIndex].title}\"`);\n    }\n    setIsPlaying(true);\n  };\n\n  // Skip tracks backward\n  const skipPrev = () => {\n    const prevIndex = queueIndex === 0 ? playQueue.length - 1 : queueIndex - 1;\n    setQueueIndex(prevIndex);\n    setCurrentSong(playQueue[prevIndex]);\n    setProgress(0);\n    triggerToast(`Playing previous: \"${playQueue[prevIndex].title}\"`);\n    setIsPlaying(true);\n  };\n\n  // Global play single song\n  const playSong = (song: Song) => {\n    setCurrentSong(song);\n    setProgress(0);\n    setIsPlaying(true);\n    \n    // Add to active play queue if not exists\n    if (!playQueue.some(s => s.id === song.id)) {\n      setPlayQueue(prev => [song, ...prev]);\n      setQueueIndex(0);\n    } else {\n      const idx = playQueue.findIndex(s => s.id === song.id);\n      setQueueIndex(idx);\n    }\n\n    // Add to history tracking\n    if (!history.some(s => s.id === song.id)) {\n      setHistory(prev => [song, ...prev.slice(0, 5)]);\n    }\n\n    triggerToast(`Decompressing FLAC node: \"${song.title}\"`);\n  };\n\n  // Global play a full playlist\n  const playPlaylist = (playlist: Playlist) => {\n    const pSongs = mockSongs.filter(s => playlist.songIds.includes(s.id));\n    if (pSongs.length > 0) {\n      setPlayQueue(pSongs);\n      setCurrentSong(pSongs[0]);\n      setQueueIndex(0);\n      setProgress(0);\n      setIsPlaying(true);\n      triggerToast(`Buffered playlist stream: \"${playlist.name}\"`);\n    }\n  };\n\n  // Favorite toggle helper\n  const handleToggleLike = (songId: string) => {\n    const isLiked = likedSongIds.includes(songId);\n    let updated: string[];\n    if (isLiked) {\n      updated = likedSongIds.filter(id => id !== songId);\n      triggerToast(\"Deleted connection accent inside index\");\n    } else {\n      updated = [...likedSongIds, songId];\n      triggerToast(\"Synthesized heart node coordinate\");\n    }\n    setLikedSongIds(updated);\n\n    // Synchronize mock songs database state as well\n    mockSongs.forEach(song => {\n      if (song.id === songId) {\n        song.isLiked = !isLiked;\n      }\n    });\n  };\n\n  // View individual playlist detail screen\n  const viewPlaylistDetail = (playlist: Playlist) => {\n    setSelectedPlaylist(playlist);\n    setActiveScreen(\'playlist-detail\');\n  };\n\n  // Save dynamically generated playlist\n  const handleAddPlaylist = (newPl: Playlist) => {\n    setPlaylists(prev => [...prev, newPl]);\n    setIsCreateModalOpen(false);\n    triggerToast(`Playlist \"${newPl.name}\" successfully generated!`);\n    viewPlaylistDetail(newPl);\n  };\n\n  // Filter globally searched tracks\n  const globalFilteredSongs = mockSongs.filter(song => \n    song.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    song.artist.toLowerCase().includes(searchQuery.toLowerCase()) ||\n    song.album.toLowerCase().includes(searchQuery.toLowerCase())\n  );\n\n  return (\n    <div className={`min-h-screen transition-colors duration-300 ${\n      isDarkMode \n        ? \'bg-obsidian-base text-obsidian-on-surface\' \n        : \'light-mode bg-zinc-50 text-zinc-900 font-sans\'\n    }`}>\n      \n      {/* 1. Global Interactive Sidebar Navigation Left Anchor */}\n      <Sidebar \n        activeScreen={activeScreen} \n        setActiveScreen={setActiveScreen}\n        onOpenCreatePlaylist={() => setIsCreateModalOpen(true)}\n        likedCount={likedSongIds.length}\n      />\n\n      {/* 2. Global Interactive Header Navigation Top Strip */}\n      <Header \n        activeScreen={activeScreen}\n        setActiveScreen={setActiveScreen}\n        searchQuery={searchQuery}\n        setSearchQuery={setSearchQuery}\n        isDarkMode={isDarkMode}\n        setIsDarkMode={setIsDarkMode}\n        onOpenNotifications={() => triggerToast(\"System Alert: High-fidelity network streaming 100% online.\")}\n        onOpenSettings={() => triggerToast(\"Advanced Audio Settings: Multi-threading acceleration active.\")}\n      />\n\n      {/* 3. Main Dashboard Display Canvas */}\n      <main className=\"ml-[280px] pt-24 pb-36 px-8 min-h-screen transition-all\">\n        {/* If user is typing keywords/searching, display filtered list instantly */}\n        {searchQuery.trim().length > 0 ? (\n          <div className=\"space-y-6 animate-fade-in select-none\">\n            <h3 className=\"font-display text-xl font-bold\">\n              Global Search Results for \"{searchQuery}\"\n            </h3>\n            \n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              {globalFilteredSongs.map(song => (\n                <div \n                  key={song.id}\n                  onClick={() => {\n                    playSong(song);\n                    setSearchQuery(\'\');\n                  }}\n                  className=\"flex items-center gap-4 bg-obsidian-container-low/60 hover:bg-obsidian-container-high/60 cursor-pointer p-3 rounded-xl border border-white/5 transition-all\"\n                >\n                  <img src={song.coverUrl} className=\"w-12 h-12 rounded object-cover shadow\" alt=\"cover\" />\n                  <div className=\"flex-1 overflow-hidden\">\n                    <p className=\"font-bold text-sm truncate\">{song.title}</p>\n                    <p className=\"text-xs text-obsidian-on-surface-variant/40 mt-0.5 truncate\">{song.artist}</p>\n                  </div>\n                  <span className=\"text-xs font-mono font-medium\">{song.duration}</span>\n                </div>\n              ))}\n              {globalFilteredSongs.length === 0 && (\n                <p className=\"text-xs text-obsidian-on-surface-variant/40\">No hi-res tracks map that query parameter.</p>\n              )}\n            </div>\n          </div>\n        ) : (\n          // Otherwise toggle screens\n          <>\n            {activeScreen === \'home\' && (\n              <HomeView \n                onPlaySong={playSong}\n                onPlayPlaylist={playPlaylist}\n                activeSongId={currentSong.id}\n                playlists={playlists}\n                onViewPlaylist={viewPlaylistDetail}\n              />\n            )}\n\n            {activeScreen === \'library\' && (\n              <LibraryView \n                playlists={playlists}\n                onPlaySong={playSong}\n                onPlayPlaylist={playPlaylist}\n                onViewPlaylist={viewPlaylistDetail}\n                activeSongId={currentSong.id}\n                onToggleLike={handleToggleLike}\n                likedSongIds={likedSongIds}\n              />\n            )}\n\n            {activeScreen === \'playlist-detail\' && selectedPlaylist && (\n              <PlaylistDetailView \n                playlist={selectedPlaylist}\n                onPlaySong={playSong}\n                onPlayPlaylist={playPlaylist}\n                activeSongId={currentSong.id}\n                isPlaying={isPlaying}\n                onTogglePlay={() => setIsPlaying(!isPlaying)}\n                likedSongIds={likedSongIds}\n                onToggleLike={handleToggleLike}\n              />\n            )}\n\n            {activeScreen === \'analytics\' && (\n              <AnalyticsView \n                currentSong={currentSong}\n                isPlaying={isPlaying}\n              />\n            )}\n          </>\n        )}\n      </main>\n\n      {/* 4. Fullscreen Immersive Lyric Theatre Drawer */}\n      {activeScreen === \'now-playing\' && (\n        <NowPlayingView \n          currentSong={currentSong}\n          isPlaying={isPlaying}\n          onTogglePlay={() => setIsPlaying(!isPlaying)}\n          progress={progress}\n          likedSongIds={likedSongIds}\n          onToggleLike={handleToggleLike}\n          onClose={() => setActiveScreen(\'home\')}\n          playQueue={playQueue}\n          onPlaySong={playSong}\n        />\n      )}\n\n      {/* 5. Persistent Player Console dock at the bottom edge */}\n      <BottomPlayer \n        currentSong={currentSong}\n        isPlaying={isPlaying}\n        onTogglePlay={() => setIsPlaying(!isPlaying)}\n        progress={progress}\n        setProgress={setProgress}\n        volume={volume}\n        setVolume={setVolume}\n        isMuted={isMuted}\n        setIsMuted={setIsMuted}\n        isShuffle={isShuffle}\n        setIsShuffle={setIsShuffle}\n        isRepeat={isRepeat}\n        setIsRepeat={setIsRepeat}\n        likedSongIds={likedSongIds}\n        onToggleLike={handleToggleLike}\n        onSkipNext={skipNext}\n        onSkipPrev={skipPrev}\n        onOpenFullscreen={() => setActiveScreen(\'now-playing\')}\n      />\n\n      {/* 6. Dynamic Generator Modal for custom compilation playlists */}\n      {isCreateModalOpen && (\n        <CreatePlaylistModal \n          onClose={() => setIsCreateModalOpen(false)}\n          onSave={handleAddPlaylist}\n        />\n      )}\n\n      {/* 7. Floating Responsive Alert Toast Box */}\n      {activeNotification && (\n        <div className=\"fixed bottom-28 right-8 z-99 animate-fade-in flex items-center gap-3 bg-obsidian-container-high/90 text-white backdrop-blur-xl border border-white/10 py-3.5 px-6 rounded-2xl shadow-xl select-none max-w-sm\">\n          <Sparkles className=\"w-4.5 h-4.5 text-secondary-emerald animate-spin\" />\n          <p className=\"text-xs font-semibold leading-relaxed font-sans\">{activeNotification}</p>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
