  file_change {
    absolute_path_uri: "file:///src/components/AddSongModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useState, useRef } from \'react\';\nimport { X, Upload, Check, Music, Image as ImageIcon } from \'lucide-react\';\nimport { Song } from \'../types\';\n\ninterface AddSongModalProps {\n  onClose: () => void;\n  onAdd: (song: Song) => void;\n  isDarkMode: boolean;\n}\n\nexport default function AddSongModal({ onClose, onAdd, isDarkMode }: AddSongModalProps) {\n  const [title, setTitle] = useState(\'\');\n  const [artist, setArtist] = useState(\'\');\n  const [album, setAlbum] = useState(\'\');\n  const [genre, setGenre] = useState(\'Ambient Electronica\');\n  const [lyricsText, setLyricsText] = useState(\'\');\n  \n  // File upload state & previews\n  const [audioFile, setAudioFile] = useState<File | null>(null);\n  const [imageFile, setImageFile] = useState<File | null>(null);\n  const [imagePreview, setImagePreview] = useState<string>(\'\');\n\n  const audioInputRef = useRef<HTMLInputElement>(null);\n  const imageInputRef = useRef<HTMLInputElement>(null);\n\n  const handleAudioChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      setAudioFile(e.target.files[0]);\n    }\n  };\n\n  const handleImageChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    if (e.target.files && e.target.files[0]) {\n      const file = e.target.files[0];\n      setImageFile(file);\n      const url = URL.createObjectURL(file);\n      setImagePreview(url);\n    }\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!title.trim() || !artist.trim()) return;\n\n    // Create dynamic URLs for playing or displaying in current session\n    const audioUrl = audioFile ? URL.createObjectURL(audioFile) : \'\';\n    const coverUrl = imageFile \n      ? imagePreview \n      : \'https://images.unsplash.com/photo-1614149162883-504ce4d13909?q=80&w=300\'; // high-quality placeholder\n\n    // Parse lyrics line by line\n    const lyricsList = lyricsText.split(\'\\n\').map(line => line.trim()).filter(line => line.length > 0);\n    if (lyricsList.length === 0) {\n      lyricsList.push(\"Enjoy the high-fidelity sound stream...\", \"Uploading your acoustic waves...\");\n    }\n\n    const newSong: Song = {\n      id: `song-custom-${Date.now()}`,\n      title: title.trim(),\n      artist: artist.trim(),\n      album: album.trim() || \'Single Release\',\n      duration: \'3:00\', // Default showcase marker\n      durationSec: 180,  // Standard default duration\n      coverUrl: coverUrl,\n      dateAdded: \'Just added\',\n      lyrics: lyricsList,\n      genre: genre,\n      isLiked: false\n    };\n\n    // If there is an audio file, try to extract its duration\n    if (audioFile) {\n      const audioObj = new Audio();\n      audioObj.src = audioUrl;\n      audioObj.addEventListener(\'loadedmetadata\', () => {\n        const secs = Math.floor(audioObj.duration);\n        const min = Math.floor(secs / 60);\n        const remSecs = secs % 60;\n        newSong.durationSec = secs;\n        newSong.duration = `${min}:${remSecs < 10 ? \'0\' : \'\'}${remSecs}`;\n        \n        // Pass with the correct estimated duration\n        onAdd(newSong);\n      });\n    } else {\n      onAdd(newSong);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-black/60 backdrop-blur-md z-[60] flex items-center justify-center p-4\">\n      <div className={`border rounded-2xl w-full max-w-lg p-6 relative overflow-hidden select-none max-h-[90vh] overflow-y-auto custom-scrollbar ${\n        isDarkMode \n          ? \'bg-obsidian-surface border-white/10 text-white\' \n          : \'bg-white border-zinc-200 text-zinc-900\'\n      }`}>\n        \n        <button \n          onClick={onClose}\n          className={`absolute top-4 right-4 transition-colors cursor-pointer ${\n            isDarkMode ? \'text-obsidian-on-surface-variant/60 hover:text-white\' : \'text-zinc-400 hover:text-zinc-600\'\n          }`}\n        >\n          <X className=\"w-5 h-5\" />\n        </button>\n\n        <h3 className=\"font-display text-xl font-bold tracking-tight mb-4 flex items-center gap-2\">\n          <Music className=\"w-5 h-5 text-primary-electric animate-bounce\" />\n          <span>Add Song from Local Files</span>\n        </h3>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className={`block text-[10px] font-bold uppercase tracking-widest leading-4 mb-1 ${\n                isDarkMode ? \'text-obsidian-on-surface-variant/60\' : \'text-zinc-500\'\n              }`}>\n                Song Title *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={title}\n                onChange={(e) => setTitle(e.target.value)}\n                placeholder=\"e.g. Amber Glitch\"\n                className={`w-full border rounded-xl px-4 py-3 text-sm focus:ring-1 focus:ring-primary-electric outline-none ${\n                  isDarkMode \n                    ? \'bg-obsidian-container-high/60 border-white/5 text-white\' \n                    : \'bg-zinc-50 border-zinc-200 text-zinc-900\'\n                }`}\n              />\n            </div>\n\n            <div>\n              <label className={`block text-[10px] font-bold uppercase tracking-widest leading-4 mb-1 ${\n                isDarkMode ? \'text-obsidian-on-surface-variant/60\' : \'text-zinc-500\'\n              }`}>\n                Artist Name *\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={artist}\n                onChange={(e) => setArtist(e.target.value)}\n                placeholder=\"e.g. Luminous Pulse\"\n                className={`w-full border rounded-xl px-4 py-3 text-sm focus:ring-1 focus:ring-primary-electric outline-none ${\n                  isDarkMode \n                    ? \'bg-obsidian-container-high/60 border-white/5 text-white\' \n                    : \'bg-zinc-50 border-zinc-200 text-zinc-900\'\n                }`}\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className={`block text-[10px] font-bold uppercase tracking-widest leading-4 mb-1 ${\n                isDarkMode ? \'text-obsidian-on-surface-variant/60\' : \'text-zinc-500\'\n              }`}>\n                Album Name\n              </label>\n              <input\n                type=\"text\"\n                value={album}\n                onChange={(e) => setAlbum(e.target.value)}\n                placeholder=\"e.g. Single Release\"\n                className={`w-full border rounded-xl px-4 py-3 text-sm focus:ring-1 focus:ring-primary-electric outline-none ${\n                  isDarkMode \n                    ? \'bg-obsidian-container-high/60 border-white/5 text-white\' \n                    : \'bg-zinc-50 border-zinc-200 text-zinc-900\'\n                }`}\n              />\n            </div>\n\n            <div>\n              <label className={`block text-[10px] font-bold uppercase tracking-widest leading-4 mb-1 ${\n                isDarkMode ? \'text-obsidian-on-surface-variant/60\' : \'text-zinc-500\'\n              }`}>\n                Audio Genre\n              </label>\n              <select\n                value={genre}\n                onChange={(e) => setGenre(e.target.value)}\n                className={`w-full border rounded-xl px-4 py-3 text-sm focus:ring-1 focus:ring-primary-electric outline-none ${\n                  isDarkMode \n                    ? \'bg-obsidian-container-high/60 border-white/5 text-white\' \n                    : \'bg-zinc-50 border-zinc-200 text-zinc-900\'\n                }`}\n              >\n                <option value=\"Ambient Electronica\">Ambient Electronica</option>\n                <option value=\"Synthwave\">Synthwave</option>\n                <option value=\"Lo-Fi Beats\">Lo-Fi Beats</option>\n                <option value=\"Classical Redefined\">Classical Redefined</option>\n                <option value=\"Vocal Jazz\">Vocal Jazz</option>\n                <option value=\"Ambient Soundscape\">Ambient Soundscape</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Pc/Mobile Attachment Section */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1\">\n            {/* Audio File Selection */}\n            <div>\n              <label className={`block text-[10px] font-bold uppercase tracking-widest leading-4 mb-2 flex items-center justify-between ${\n                isDarkMode ? \'text-obsidian-on-surface-variant/60\' : \'text-zinc-500\'\n              }`}>\n                <span>Audio Track (PC/Mobile)</span>\n                {audioFile && <span className=\"text-secondary-emerald font-mono flex items-center gap-0.5\"><Check className=\"w-3 h-3\" /> Loaded</span>}\n              </label>\n              <input\n                type=\"file\"\n                ref={audioInputRef}\n                onChange={handleAudioChange}\n                accept=\"audio/*\"\n                className=\"hidden\"\n              />\n              <div \n                onClick={() => audioInputRef.current?.click()}\n                className={`border-2 border-dashed rounded-xl p-4 text-center cursor-pointer hover:border-primary-electric transition-all flex flex-col items-center justify-center gap-1 ${\n                  isDarkMode \n                    ? \'bg-obsidian-container-low/50 hover:bg-obsidian-container-low border-white/10\' \n                    : \'bg-zinc-50 hover:bg-zinc-100 border-zinc-200\'\n                }`}\n              >\n                <Upload className=\"w-5 h-5 text-primary-electric\" />\n                <span className=\"text-xs font-bold truncate max-w-[160px]\">\n                  {audioFile ? audioFile.name : \'Choose Audio File\'}\n                </span>\n                <span className=\"text-[9px] text-zinc-400\">MP3, WAV, M4A accepted</span>\n              </div>\n            </div>\n\n            {/* Image Cover Selection */}\n            <div>\n              <label className={`block text-[10px] font-bold uppercase tracking-widest leading-4 mb-2 flex items-center justify-between ${\n                isDarkMode ? \'text-obsidian-on-surface-variant/60\' : \'text-zinc-500\'\n              }`}>\n                <span>Album Cover</span>\n                {imageFile && <span className=\"text-secondary-emerald font-mono flex items-center gap-0.5\"><Check className=\"w-3 h-3\" /> Custom</span>}\n              </label>\n              <input\n                type=\"file\"\n                ref={imageInputRef}\n                onChange={handleImageChange}\n                accept=\"image/*\"\n                className=\"hidden\"\n              />\n              <div className=\"flex gap-3\">\n                <div \n                  onClick={() => imageInputRef.current?.click()}\n                  className={`border-2 border-dashed rounded-xl p-4 text-center cursor-pointer hover:border-primary-electric transition-all flex flex-col items-center justify-center gap-1 flex-1 ${\n                    isDarkMode \n                      ? \'bg-obsidian-container-low/50 hover:bg-obsidian-container-low border-white/10\' \n                      : \'bg-zinc-50 hover:bg-zinc-100 border-zinc-200\'\n                  }`}\n                >\n                  <ImageIcon className=\"w-5 h-5 text-secondary-emerald\" />\n                  <span className=\"text-xs font-bold truncate max-w-[100px]\">\n                    {imageFile ? imageFile.name : \'Choose Cover\'}\n                  </span>\n                  <span className=\"text-[9px] text-zinc-400\">JPG, PNG, WEBP</span>\n                </div>\n                \n                {imagePreview && (\n                  <div className=\"w-16 h-16 rounded-xl overflow-hidden border border-white/10 flex-shrink-0 bg-zinc-900 relative\">\n                    <img src={imagePreview} className=\"w-full h-full object-cover\" alt=\"Selected Cover\" />\n                  </div>\n                )}\n              </div>\n            </div>\n          </div>\n\n          <div>\n            <label className={`block text-[10px] font-bold uppercase tracking-widest leading-4 mb-1 ${\n              isDarkMode ? \'text-obsidian-on-surface-variant/60\' : \'text-zinc-500\'\n            }`}>\n              Lyrics (Optional - Line by Line)\n            </label>\n            <textarea\n              value={lyricsText}\n              onChange={(e) => setLyricsText(e.target.value)}\n              placeholder=\"Midnight echoes fading trace&#10;Watching as the hours pass...\"\n              className={`w-full border rounded-xl px-4 py-3 text-xs outline-none focus:ring-1 focus:ring-primary-electric h-16 resize-none custom-scrollbar ${\n                isDarkMode \n                  ? \'bg-obsidian-container-high/60 border-white/5 text-white\' \n                  : \'bg-zinc-50 border-zinc-200 text-zinc-900\'\n              }`}\n            />\n          </div>\n\n          <div className=\"flex items-center justify-end gap-3 pt-3\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className={`px-5 py-2.5 rounded-full text-xs font-semibold cursor-pointer ${\n                isDarkMode ? \'text-white/70 hover:text-white hover:bg-white/5\' : \'text-zinc-500 hover:text-zinc-700 hover:bg-zinc-100\'\n              }`}\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-6 py-2.5 rounded-full bg-primary-electric text-obsidian-base font-bold text-xs hover:scale-105 active:scale-95 transition-transform primary-glow cursor-pointer\"\n            >\n              Upload Track\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n"
    }
