    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React from \'react\';\nimport { \n  Home, \n  Search, \n  Library, \n  PlusSquare, \n  Heart, \n  Podcast, \n  BarChart3, \n  Compass, \n  Download, \n  Music,\n  Flame\n} from \'lucide-react\';\nimport { ActiveScreen } from \'../types\';\n\ninterface SidebarProps {\n  activeScreen: ActiveScreen;\n  setActiveScreen: (screen: ActiveScreen) => void;\n  onOpenCreatePlaylist: () => void;\n  likedCount: number;\n}\n\nexport default function Sidebar({\n  activeScreen,\n  setActiveScreen,\n  onOpenCreatePlaylist,\n  likedCount\n}: SidebarProps) {\n  return (\n    <aside className=\"fixed left-0 top-0 h-screen w-[280px] bg-obsidian-container-low border-r border-[#ffffff]/5 flex flex-col py-8 px-4 z-50 transition-all select-none\">\n      {/* Brand Header */}\n      <div className=\"mb-8 px-2 cursor-pointer\" onClick={() => setActiveScreen(\'home\')}>\n        <div className=\"flex items-center gap-2\">\n          <Flame className=\"w-8 h-8 text-primary-electric animate-pulse\" />\n          <h1 className=\"font-display text-2xl font-bold text-primary-electric tracking-tight\">\n            SonicObsidian\n          </h1>\n        </div>\n        <p className=\"text-xs font-sans text-obsidian-on-surface-variant/60 mt-1 pl-1 font-medium\">\n          Premium Member\n        </p>\n      </div>\n\n      {/* Navigation Mapping */}\n      <nav className=\"flex-1 space-y-1.5 overflow-y-auto custom-scrollbar\">\n        <button\n          onClick={() => setActiveScreen(\'home\')}\n          className={`w-full flex items-center gap-4 py-3 px-4 rounded-lg font-sans text-sm font-medium transition-all cursor-pointer ${\n            activeScreen === \'home\'\n              ? \'text-white border-l-4 border-primary-electric bg-[#ffffff]/5 font-bold \'\n              : \'text-obsidian-on-surface-variant/60 hover:text-white hover:bg-obsidian-container-high\'\n          }`}\n        >\n          <Home className={`w-5 h-5 ${activeScreen === \'home\' ? \'text-primary-electric\' : \'\'}`} />\n          <span>Home</span>\n        </button>\n\n        <button\n          onClick={() => setActiveScreen(\'library\')}\n          className={`w-full flex items-center gap-4 py-3 px-4 rounded-lg font-sans text-sm font-medium transition-all cursor-pointer ${\n            activeScreen === \'library\'\n              ? \'text-white border-l-4 border-primary-electric bg-[#ffffff]/5 font-bold \'\n              : \'text-obsidian-on-surface-variant/60 hover:text-white hover:bg-obsidian-container-high\'\n          }`}\n        >\n          <Library className={`w-5 h-5 ${activeScreen === \'library\' ? \'text-primary-electric\' : \'\'}`} />\n          <span>Your Library</span>\n        </button>\n\n        <button\n          onClick={() => setActiveScreen(\'analytics\')}\n          className={`w-full flex items-center gap-4 py-3 px-4 rounded-lg font-sans text-sm font-medium transition-all cursor-pointer ${\n            activeScreen === \'analytics\'\n              ? \'text-white border-l-4 border-secondary-emerald bg-[#ffffff]/5 font-bold \'\n              : \'text-obsidian-on-surface-variant/60 hover:text-white hover:bg-obsidian-container-high\'\n          }`}\n        >\n          <BarChart3 className={`w-5 h-5 ${activeScreen === \'analytics\' ? \'text-secondary-emerald\' : \'\'}`} />\n          <span>H-Fi Analytics</span>\n        </button>\n\n        <button\n          onClick={onOpenCreatePlaylist}\n          className=\"w-full flex items-center gap-4 py-3 px-4 rounded-lg font-sans text-sm font-medium text-obsidian-on-surface-variant/60 hover:text-white hover:bg-obsidian-container-high transition-all cursor-pointer text-left\"\n        >\n          <PlusSquare className=\"w-5 h-5 text-obsidian-on-surface-variant/40 group-hover:text-white\" />\n          <span>Create Playlist</span>\n        </button>\n\n        {/* Separator / Library Header */}\n        <div className=\"pt-6 pb-2\">\n          <h3 className=\"px-4 text-[10px] font-bold text-obsidian-on-surface-variant/40 uppercase tracking-widest leading-4 mb-2\">\n            Your Library Accents\n          </h3>\n          \n          <button\n            onClick={() => setActiveScreen(\'library\')}\n            className=\"w-full flex items-center gap-4 py-2 px-4 rounded-lg font-sans text-sm font-medium text-obsidian-on-surface-variant/60 hover:text-white hover:bg-obsidian-container-high transition-all cursor-pointer text-left\"\n          >\n            <Heart className=\"w-4 h-4 text-primary-electric fill-primary-electric\" />\n            <div className=\"flex justify-between items-center w-full\">\n              <span>Liked Songs</span>\n              <span className=\"text-[10px] px-1.5 py-0.5 rounded-full bg-primary-electric/10 text-primary-electric\">\n                {likedCount}\n              </span>\n            </div>\n          </button>\n\n          <button\n            onClick={() => setActiveScreen(\'library\')}\n            className=\"w-full flex items-center gap-4 py-2 px-4 rounded-lg font-sans text-sm font-medium text-obsidian-on-surface-variant/60 hover:text-white hover:bg-obsidian-container-high transition-all cursor-pointer text-left mt-1\"\n          >\n            <Podcast className=\"w-4 h-4 text-secondary-emerald\" />\n            <span>Your Episodes</span>\n          </button>\n        </div>\n      </nav>\n\n      {/* Install Desktop App Accent */}\n      <div className=\"mt-auto pt-4 border-t border-[#ffffff]/5\">\n        <button className=\"w-full flex items-center justify-center gap-2 py-3 px-4 bg-obsidian-container-high hover:bg-obsidian-container-highest text-white rounded-full font-sans text-xs font-semibold hover:text-primary-electric transition-all shadow-md cursor-pointer border border-[#ffffff]/5\">\n          <Download className=\"w-4 h-4\" />\n          <span>Install Desktop App</span>\n        </button>\n      </div>\n    </aside>\n  );\n}\n"
    }
