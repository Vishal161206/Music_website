  file_change {
    absolute_path_uri: "file:///src/components/BottomPlayer.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useRef } from \'react\';\nimport { \n  Heart, \n  Shuffle, \n  SkipBack, \n  Play, \n  Pause, \n  SkipForward, \n  Repeat, \n  Mic2, \n  ListMusic, \n  Volume2, \n  VolumeX, \n  Maximize2,\n  Tv\n} from \'lucide-react\';\nimport { Song } from \'../types\';\n\ninterface BottomPlayerProps {\n  currentSong: Song;\n  isPlaying: boolean;\n  onTogglePlay: () => void;\n  progress: number;\n  setProgress: (prog: number) => void;\n  volume: number;\n  setVolume: (vol: number) => void;\n  isMuted: boolean;\n  setIsMuted: (muted: boolean) => void;\n  isShuffle: boolean;\n  setIsShuffle: (shuf: boolean) => void;\n  isRepeat: boolean;\n  setIsRepeat: (rep: boolean) => void;\n  likedSongIds: string[];\n  onToggleLike: (songId: string) => void;\n  onSkipNext: () => void;\n  onSkipPrev: () => void;\n  onOpenFullscreen: () => void;\n}\n\nexport default function BottomPlayer({\n  currentSong,\n  isPlaying,\n  onTogglePlay,\n  progress,\n  setProgress,\n  volume,\n  setVolume,\n  isMuted,\n  setIsMuted,\n  isShuffle,\n  setIsShuffle,\n  isRepeat,\n  setIsRepeat,\n  likedSongIds,\n  onToggleLike,\n  onSkipNext,\n  onSkipPrev,\n  onOpenFullscreen\n}: BottomPlayerProps) {\n  const progressBarRef = useRef<HTMLDivElement>(null);\n  const isLiked = likedSongIds.includes(currentSong.id);\n\n  // Format digital time markers (e.g. 1:24 or 3:45)\n  const formatTime = (secs: number) => {\n    const min = Math.floor(secs / 60);\n    const sec = Math.floor(secs % 60);\n    return `${min}:${sec < 10 ? \'0\' : \'\'}${sec}`;\n  };\n\n  // Interactive seek handling\n  const handleProgressSeek = (e: React.MouseEvent<HTMLDivElement>) => {\n    if (progressBarRef.current) {\n      const rect = progressBarRef.current.getBoundingClientRect();\n      const clickX = e.clientX - rect.left;\n      const width = rect.width;\n      const clickedRatio = Math.max(0, Math.min(1, clickX / width));\n      setProgress(Math.floor(clickedRatio * currentSong.durationSec));\n    }\n  };\n\n  // Click handler for volume slider\n  const handleVolumeSeek = (e: React.MouseEvent<HTMLDivElement>) => {\n    const rect = e.currentTarget.getBoundingClientRect();\n    const clickX = e.clientX - rect.left;\n    const width = rect.width;\n    const clickedVol = Math.floor(Math.max(0, Math.min(1, clickX / width)) * 100);\n    setVolume(clickedVol);\n    if (clickedVol > 0 && isMuted) {\n      setIsMuted(false);\n    }\n  };\n\n  const progressPercent = (progress / currentSong.durationSec) * 100;\n\n  return (\n    <footer className=\"fixed bottom-0 left-0 w-full h-24 bg-obsidian-container-low/95 backdrop-blur-2xl border-t border-[#ffffff]/5 z-50 flex items-center justify-between px-8 select-none shadow-[0_-10px_40px_rgba(0,0,0,0.6)] transition-all\">\n      {/* Track Segment (Left Corner) */}\n      <div \n        onClick={onOpenFullscreen}\n        className=\"flex items-center gap-4 w-1/4 group cursor-pointer\"\n        title=\"Open Now Playing\"\n      >\n        <div className=\"w-16 h-16 rounded-lg overflow-hidden flex-shrink-0 shadow-lg border border-[#ffffff]/10 relative\">\n          <img \n            alt=\"Current Album Art\" \n            className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\"\n            src={currentSong.coverUrl}\n          />\n        </div>\n        <div className=\"overflow-hidden max-w-[150px]\">\n          <h6 className=\"font-sans font-bold text-sm text-white truncate group-hover:text-primary-electric group-hover:underline\">\n            {currentSong.title}\n          </h6>\n          <p className=\"font-sans text-xs text-obsidian-on-surface-variant/60 truncate group-hover:underline mt-0.5\">\n            {currentSong.artist}\n          </p>\n        </div>\n        <button \n          onClick={(e) => {\n            e.stopPropagation();\n            onToggleLike(currentSong.id);\n          }}\n          className=\"text-obsidian-on-surface-variant/60 hover:text-primary-electric transition-transform hover:scale-110 cursor-pointer ml-1\"\n        >\n          <Heart \n            className={`w-5 h-5 ${isLiked ? \'text-primary-electric fill-primary-electric\' : \'\'}`} \n          />\n        </button>\n      </div>\n\n      {/* Control console (Center Hub) */}\n      <div className=\"flex flex-col items-center gap-2.5 w-1/2 max-w-xl\">\n        <div className=\"flex items-center gap-7\">\n          <button \n            onClick={() => setIsShuffle(!isShuffle)}\n            className={`transition-colors cursor-pointer ${\n              isShuffle ? \'text-secondary-emerald\' : \'text-obsidian-on-surface-variant/40 hover:text-white\'\n            }`}\n            title=\"Shuffle\"\n          >\n            <Shuffle className=\"w-4 h-4\" />\n          </button>\n\n          <button \n            onClick={onSkipPrev}\n            className=\"text-obsidian-on-surface-variant/60 hover:text-white transition-all hover:scale-105 cursor-pointer\"\n            title=\"Previous Track\"\n          >\n            <SkipBack className=\"w-5 h-5 fill-current\" />\n          </button>\n\n          <button \n            onClick={onTogglePlay}\n            className=\"w-12 h-12 bg-white text-black hover:bg-primary-electric rounded-full flex items-center justify-center hover:scale-110 active:scale-95 transition-all shadow-[0_0_20px_rgba(255,255,255,0.15)] cursor-pointer\"\n            title={isPlaying ? \'Pause\' : \'Play\'}\n          >\n            {isPlaying ? (\n              <Pause className=\"w-5 h-5 fill-current\" />\n            ) : (\n              <Play className=\"w-5 h-5 fill-current translate-x-0.5\" />\n            )}\n          </button>\n\n          <button \n            onClick={onSkipNext}\n            className=\"text-obsidian-on-surface-variant/60 hover:text-white transition-all hover:scale-105 cursor-pointer\"\n            title=\"Next Track\"\n          >\n            <SkipForward className=\"w-5 h-5 fill-current\" />\n          </button>\n\n          <button \n            onClick={() => setIsRepeat(!isRepeat)}\n            className={`transition-colors cursor-pointer ${\n              isRepeat ? \'text-secondary-emerald\' : \'text-obsidian-on-surface-variant/40 hover:text-white\'\n            }`}\n            title=\"Repeat\"\n          >\n            <Repeat className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Progress Timeline */}\n        <div className=\"w-full flex items-center gap-3\">\n          <span className=\"font-mono text-[10px] text-obsidian-on-surface-variant/40 min-w-[28px] text-right\">\n            {formatTime(progress)}\n          </span>\n          <div \n            ref={progressBarRef}\n            onClick={handleProgressSeek}\n            className=\"flex-1 h-1.5 bg-[#ffffff]/10 hover:bg-[#ffffff]/15 rounded-full relative group cursor-pointer transition-colors\"\n          >\n            <div \n              style={{ width: `${progressPercent}%` }}\n              className=\"absolute top-0 left-0 h-full bg-gradient-to-r from-primary-electric to-secondary-emerald rounded-full\"\n            />\n            {/* Knob visible on hover */}\n            <div \n              style={{ left: `${progressPercent}%` }}\n              className=\"absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3.5 h-3.5 bg-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-lg\"\n            />\n          </div>\n          <span className=\"font-mono text-[10px] text-obsidian-on-surface-variant/40 min-w-[28px]\">\n            {formatTime(currentSong.durationSec)}\n          </span>\n        </div>\n      </div>\n\n      {/* Trailing Indicators (Right Corner) */}\n      <div className=\"flex items-center justify-end gap-5 w-1/4 text-obsidian-on-surface-variant/60\">\n        <button \n          onClick={onOpenFullscreen}\n          className=\"hover:text-white transition-colors cursor-pointer\"\n          title=\"Lyrics\"\n        >\n          <Mic2 className=\"w-4.5 h-4.5\" />\n        </button>\n\n        <button \n          onClick={onOpenFullscreen}\n          className=\"hover:text-white transition-colors cursor-pointer\"\n          title=\"Play Queue\"\n        >\n          <ListMusic className=\"w-5 h-5\" />\n        </button>\n\n        {/* Volume controls */}\n        <div className=\"flex items-center gap-2 group w-28 ml-1\">\n          <button \n            onClick={() => setIsMuted(!isMuted)}\n            className=\"hover:text-white transition-colors cursor-pointer\"\n            title={isMuted ? \'Unmute\' : \'Mute\'}\n          >\n            {isMuted || volume === 0 ? (\n              <VolumeX className=\"w-4.5 h-4.5 text-primary-electric\" />\n            ) : (\n              <Volume2 className=\"w-4.5 h-4.5 text-obsidian-on-surface-variant/80 group-hover:text-white\" />\n            )}\n          </button>\n          \n          <div \n            onClick={handleVolumeSeek}\n            className=\"flex-1 h-1 bg-[#ffffff]/10 hover:bg-[#ffffff]/15 rounded-full relative cursor-pointer\"\n          >\n            <div \n              style={{ width: `${isMuted ? 0 : volume}%` }}\n              className=\"h-full bg-primary-electric hover:bg-secondary-emerald rounded-full transition-all\"\n            />\n          </div>\n        </div>\n\n        <button \n          onClick={onOpenFullscreen}\n          className=\"hover:text-white transition-all hover:scale-105 ml-3 cursor-pointer\"\n          title=\"Enter Fullscreen\"\n        >\n          <Maximize2 className=\"w-4 h-4\" />\n        </button>\n      </div>\n    </footer>\n  );\n}\n"
    }
