    replacement_chunks {
      replacement_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nimport React, { useEffect, useState } from \'react\';\nimport { Play, Plus, Check, Star, Users, Music } from \'lucide-react\';\nimport { Song, Playlist } from \'../types\';\nimport { mockSongs, mockPlaylists } from \'../data\';\n\ninterface HomeViewProps {\n  onPlaySong: (song: Song) => void;\n  onPlayPlaylist: (playlist: Playlist) => void;\n  activeSongId: string;\n  playlists: Playlist[];\n  onViewPlaylist: (playlist: Playlist) => void;\n}\n\nexport default function HomeView({\n  onPlaySong,\n  onPlayPlaylist,\n  activeSongId,\n  playlists,\n  onViewPlaylist\n}: HomeViewProps) {\n  const [visualizerHeights, setVisualizerHeights] = useState<number[]>([40, 70, 50, 90, 30, 80, 45, 60, 35, 75, 55, 95]);\n\n  // Simulate active decorative graphic visualizer\n  useEffect(() => {\n    const handleInterval = setInterval(() => {\n      setVisualizerHeights(prev => prev.map(() => Math.floor(Math.random() * 75) + 25));\n    }, 150);\n    return () => clearInterval(handleInterval);\n  }, []);\n\n  // Filter songs that appear in recently played\n  const recentlyPlayedSongs = mockSongs.slice(1, 7); // Neon Echoes down to Late Night Haze\n\n  const hyperSonicFusionPlaylist: Playlist = {\n    id: \'pl-fusion\',\n    name: \'Hyper-Sonic Fusion\',\n    coverUrl: \'https://lh3.googleusercontent.com/aida-public/AB6AXuCgP7i-PERiBCLnQH4bSo56P2mib1ED4fjkEemmF9Bn7EG44Pin93T3tRAJ384rjc4FUEv10Ykn7OaUXliXAH24WiCrvBLlap2DLZ7E3jlvxAmzpzNM9NAaD1b-KOapKdkHWEoEdjulGRjYy4BCHJ6l9DcRQwWlTx7Hw-xfE9PJM2p7mBRq3hr5cnc4e_3kONgpFrmvjoe4tySVfJjHZnT5XYbnJH6aeYUUB2up-z5E07n6WlDGsBVMFEXR9BWo2B1Yb5zE7_qxJg8\',\n    songIds: [\'12\', \'13\', \'8\', \'2\', \'3\'],\n    isPublic: true\n  };\n\n  const obsidianMidnightSessions: Playlist = {\n    id: \'pl-obsidian-midnight\',\n    name: \'Obsidian Midnight Sessions\',\n    coverUrl: \'https://lh3.googleusercontent.com/aida-public/AB6AXuD0lzEKsJLIw6XKljK5b9oLeC78fk2J4_MUNplTyGVLaWyUVbVpFlS9m3OC97lmt7itN3B_wqHmioeUlLlzQEKNUrtifi-a-ObK3sXSU6afwct0NLgouHZ034EHTtDIeAQnFCxjnAHsqa-ft3IO5hZq_TWAoS2gL4gVKnNE9tHhkM-_E2yRESMXA_FekwEUujEmg-kYYD6WR_DB1Zp1Ii7cfRIFUFFjq2ndgP3PnVK8BNm4tagj8D78PiqnklLB1kJRT5NKUIjG4AM\',\n    songIds: [\'11\', \'1\', \'2\', \'4\', \'8\'],\n    isPublic: true\n  };\n\n  const deepWorkPlaylist = playlists.find(p => p.id === \'pl-focus-flow\') || playlists[0];\n  const rhythmResetPlaylist = playlists.find(p => p.id === \'pl-obsidian-beats\') || playlists[0];\n  const analogWarmthPlaylist = playlists.find(p => p.id === \'pl-late-night\') || playlists[0];\n\n  return (\n    <div className=\"space-y-10 animate-fade-in p-2\">\n      {/* Hero Banner: Made For You */}\n      <section className=\"relative h-[480px] rounded-3xl overflow-hidden group border border-[#ffffff]/5 shadow-2xl\">\n        <div className=\"absolute inset-0 z-0\">\n          <img \n            className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" \n            alt=\"Soulful jazz musician\" \n            src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuD0lzEKsJLIw6XKljK5b9oLeC78fk2J4_MUNplTyGVLaWyUVbVpFlS9m3OC97lmt7itN3B_wqHmioeUlLlzQEKNUrtifi-a-ObK3sXSU6afwct0NLgouHZ034EHTtDIeAQnFCxjnAHsqa-ft3IO5hZq_TWAoS2gL4gVKnNE9tHhkM-_E2yRESMXA_FekwEUujEmg-kYYD6WR_DB1Zp1Ii7cfRIFUFFjq2ndgP3PnVK8BNm4tagj8D78PiqnklLB1kJRT5NKUIjG4AM\"\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-obsidian-base via-transparent to-black/20\" />\n          <div className=\"absolute inset-0 bg-gradient-to-r from-obsidian-base via-black/40 to-transparent\" />\n        </div>\n        \n        <div className=\"relative z-10 h-full flex flex-col justify-end p-12 max-w-2xl select-none\">\n          <div className=\"flex items-center gap-3 mb-4\">\n            <span className=\"bg-primary-electric/20 text-primary-electric px-3.5 py-1 rounded-full text-[10px] font-bold tracking-widest backdrop-blur-md border border-primary-electric/25\">\n              EXCLUSIVE MIX\n            </span>\n            {/* Visualizer bars */}\n            <div className=\"flex items-end gap-[3px] h-4\">\n              {visualizerHeights.map((h, i) => (\n                <div \n                  key={i} \n                  style={{ height: `${h}%` }}\n                  className=\"w-1.5 bg-gradient-to-t from-primary-electric to-secondary-emerald rounded-full transition-all duration-150\"\n                />\n              ))}\n            </div>\n          </div>\n          \n          <h2 className=\"font-display text-5xl md:text-6xl font-extrabold mb-4 leading-none tracking-tighter text-white\">\n            Obsidian Midnight Sessions\n          </h2>\n          <p className=\"text-sm md:text-base font-sans text-obsidian-on-surface-variant/80 mb-8 max-w-lg leading-relaxed\">\n            Dive into a curated journey of deep house and neo-jazz specifically engineered for your late-night creative flow.\n          </p>\n          \n          <div className=\"flex items-center gap-4\">\n            <button \n              onClick={() => onPlayPlaylist(obsidianMidnightSessions)}\n              className=\"bg-primary-electric text-obsidian-base px-8 py-4 rounded-full text-xs font-bold flex items-center gap-2 hover:scale-105 active:scale-95 transition-transform primary-glow cursor-pointer\"\n            >\n              <Play className=\"w-4.5 h-4.5 fill-current\" />\n              <span>Play Now</span>\n            </button>\n            <button \n              onClick={() => onViewPlaylist(playlists.find(p => p.id === \'pl-master\') || playlists[0])}\n              className=\"border border-[#ffffff]/20 hover:bg-[#ffffff]/10 text-white px-8 py-4 rounded-full text-xs font-bold backdrop-blur-md transition-all cursor-pointer\"\n            >\n              Save to Library\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* Recently Played Bento Grid */}\n      <section>\n        <div className=\"flex items-center justify-between mb-6\">\n          <h3 className=\"font-display text-2xl font-bold text-white tracking-tight\">\n            Recently Played\n          </h3>\n          <button \n            onClick={() => onViewPlaylist(playlists.find(p => p.id === \'pl-master\') || playlists[0])}\n            className=\"text-xs font-bold text-primary-electric hover:underline cursor-pointer\"\n          >\n            Show All\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6\">\n          {recentlyPlayedSongs.map((song) => {\n            const isActive = activeSongId === song.id;\n            return (\n              <div \n                key={song.id}\n                onClick={() => onPlaySong(song)}\n                className={`group relative bg-obsidian-container-low p-4 rounded-xl transition-all duration-300 hover:bg-obsidian-container-high hover:scale-[1.02] cursor-pointer shadow-lg border border-[#ffffff]/5 ${\n                  isActive ? \'border-primary-electric/40 primary-glow\' : \'\'\n                }`}\n              >\n                <div className=\"relative aspect-square rounded-lg overflow-hidden mb-4 shadow\">\n                  <img \n                    className=\"w-full h-full object-cover transition-transform duration-500 group-hover:scale-105\" \n                    alt={song.title} \n                    src={song.coverUrl}\n                  />\n                  {/* Floating click play overlay */}\n                  <div className=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center\">\n                    <button className=\"w-12 h-12 bg-primary-electric text-obsidian-base rounded-full flex items-center justify-center hover:scale-110 active:scale-95 transition-transform primary-glow shadow-lg cursor-pointer\">\n                      <Play className=\"w-5 h-5 fill-current translate-x-0.5\" />\n                    </button>\n                  </div>\n                </div>\n                \n                <h4 className=\"font-sans font-bold text-sm truncate text-white\">\n                  {song.title}\n                </h4>\n                <p className=\"font-sans text-xs text-obsidian-on-surface-variant/40 mt-1 truncate\">\n                  {song.artist}\n                </p>\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* Featured Playlists (Asymmetric Layout) */}\n      <section>\n        <div className=\"flex items-center justify-between mb-6\">\n          <h3 className=\"font-display text-2xl font-bold text-white tracking-tight\">\n            Curated For You\n          </h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n          {/* Large Curated Card (2 cols) */}\n          <div \n            onClick={() => onPlayPlaylist(hyperSonicFusionPlaylist)}\n            className=\"md:col-span-2 relative group rounded-3xl overflow-hidden h-[400px] cursor-pointer hover:shadow-[0_20px_45px_rgba(0,0,0,0.4)] border border-[#ffffff]/5\"\n          >\n            <img \n              className=\"absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]\" \n              alt=\"Futuristic Skyline\"\n              src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuCgP7i-PERiBCLnQH4bSo56P2mib1ED4fjkEemmF9Bn7EG44Pin93T3tRAJ384rjc4FUEv10Ykn7OaUXliXAH24WiCrvBLlap2DLZ7E3jlvxAmzpzNM9NAaD1b-KOapKdkHWEoEdjulGRjYy4BCHJ6l9DcRQwWlTx7Hw-xfE9PJM2p7mBRq3hr5cnc4e_3kONgpFrmvjoe4tySVfJjHZnT5XYbnJH6aeYUUB2up-z5E07n6WlDGsBVMFEXR9BWo2B1Yb5zE7_qxJg8\"\n            />\n            {/* Overlay gradients for high premium text styling */}\n            <div className=\"absolute inset-0 bg-gradient-to-t from-obsidian-base/90 via-transparent to-black/20\" />\n            \n            <div className=\"absolute bottom-0 left-0 p-10 select-none\">\n              <span className=\"text-secondary-emerald font-sans text-[10px] font-bold tracking-widest uppercase mb-1.5 block\">\n                Trending Worldwide\n              </span>\n              <h4 className=\"font-display text-4xl font-extrabold text-white mb-4 leading-tight\">\n                Hyper-Sonic Fusion\n              </h4>\n              <div className=\"flex items-center gap-4\">\n                <button className=\"bg-white text-black px-6 py-2.5 rounded-full text-xs font-bold hover:scale-105 transition-transform shadow-lg cursor-pointer\">\n                  Listen Now\n                </button>\n                <div className=\"flex -space-x-3 items-center\">\n                  <img alt=\"Contributor\" className=\"w-8 h-8 rounded-full border-2 border-obsidian-base\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuB2kB8x5yDeG7U-yH05cMK2ovWXI4H_huWgyGVczegb4WRJtfINMdJ2hjTLAjxgbYjQlQtgqvV4kWSrHP57dRvlnHsvydXi1mHCaTuv1dS2pr7swrx7T-4RUKWTA7NzhjyEWayJadJQKCENbdgOMiRrMugMEVTqqfffFaLdFiJyNbZ_Pb6_u5h2ljlOWJd9m-8Rqe2A2DDsuq6012U1rLAvUVLHOYKsIRDsVm4c4JIg3Pd_BLfyzB-uXZPQlXKbsELOYUm4Y9ZRt4M\" />\n                  <img alt=\"Contributor\" className=\"w-8 h-8 rounded-full border-2 border-obsidian-base\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDBkcoPT4j4BPyt7S3taozQeyFo0fbA5o8EcL3B2HzH8ZW8gPQK1uS8J5YsMKOHOleuoD9SDiNDzI4s9OrjgV6YNsv8yQx0h-msPrDGlE2QJY1z-OLuOteCPR3yY9rdtb1lGbMM-gbNr7LHYSL2pH90Fx5yvLytbou0JoTnYFw3HMX4FaVgJm8AvulOAafJbiMMLaDJORGC97ekELEK-H-O1cz0a7t3lCTz51p9HnD_4WyAFECG-QD5olN2RvK1-EZF2WpokMTXFgU\" />\n                  <img alt=\"Contributor\" className=\"w-8 h-8 rounded-full border-2 border-obsidian-base\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuAx9wh8a5WVfbWgrlzgrsQWcbImVCvh9RkZAebiFi-XbsiUSQtDc66g6N888yzWFAltGN5TKMwquGS284qGMb-cPYBNlE0sM_spYeANh_rhG-ljaqPESmozwaqVQ1IHVGTFnakssyOjMNsQvqPz2ccyNd8qilPtjMuur8BCxCji4SOUEpFvq_q2KFGSesRCkq4u3ys5FEKdsCqoDanLog1cZGb1-agebIb0G49NVoSZod60ZtL0oryAx-LGza_f49e8nQcCm0lavGg\" />\n                  <div className=\"w-8 h-8 rounded-full bg-obsidian-container-high border-2 border-obsidian-base flex items-center justify-center text-[10px] font-bold text-white\">\n                    +12\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Curated Stack List (Right Side) */}\n          <div className=\"flex flex-col justify-between space-y-6\">\n            {/* Deep Work */}\n            <div \n              onClick={() => onPlayPlaylist(deepWorkPlaylist)}\n              className=\"bg-obsidian-container-low p-5 rounded-2xl group hover:bg-obsidian-container-high transition-all border border-[#ffffff]/5 cursor-pointer\"\n            >\n              <div className=\"flex gap-4 items-center\">\n                <div className=\"w-16 h-16 rounded-xl overflow-hidden flex-shrink-0 shadow\">\n                  <img \n                    className=\"w-full h-full object-cover transition-transform group-hover:scale-105\" \n                    alt=\"Deep Work\" \n                    src={deepWorkPlaylist.coverUrl}\n                  />\n                </div>\n                <div>\n                  <h5 className=\"font-display font-semibold text-sm text-white group-hover:text-primary-electric transition-colors\">\n                    {deepWorkPlaylist.name}\n                  </h5>\n                  <p className=\"text-xs text-obsidian-on-surface-variant/40 mt-1 font-sans\">\n                    Flow state essentials\n                  </p>\n                </div>\n                <button className=\"ml-auto w-9 h-9 rounded-full bg-white/10 hover:bg-primary-electric hover:text-black flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all cursor-pointer\">\n                  <Play className=\"w-4 h-4 fill-current translate-x-0.5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Rhythm Reset */}\n            <div \n              onClick={() => onPlayPlaylist(rhythmResetPlaylist)}\n              className=\"bg-obsidian-container-low p-5 rounded-2xl group hover:bg-obsidian-container-high transition-all border border-[#ffffff]/5 cursor-pointer\"\n            >\n              <div className=\"flex gap-4 items-center\">\n                <div className=\"w-16 h-16 rounded-xl overflow-hidden flex-shrink-0 shadow\">\n                  <img \n                    className=\"w-full h-full object-cover transition-transform group-hover:scale-105\" \n                    alt=\"Rhythm Reset\" \n                    src={rhythmResetPlaylist.coverUrl}\n                  />\n                </div>\n                <div>\n                  <h5 className=\"font-display font-semibold text-sm text-white group-hover:text-primary-electric transition-colors\">\n                    {rhythmResetPlaylist.name}\n                  </h5>\n                  <p className=\"text-xs text-obsidian-on-surface-variant/40 mt-1 font-sans\">\n                    Upbeat electronica\n                  </p>\n                </div>\n                <button className=\"ml-auto w-9 h-9 rounded-full bg-white/10 hover:bg-primary-electric hover:text-black flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all cursor-pointer\">\n                  <Play className=\"w-4 h-4 fill-current translate-x-0.5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* Analog Warmth */}\n            <div \n              onClick={() => onPlayPlaylist(analogWarmthPlaylist)}\n              className=\"bg-obsidian-container-low p-5 rounded-2xl group hover:bg-obsidian-container-high transition-all border border-[#ffffff]/5 cursor-pointer\"\n            >\n              <div className=\"flex gap-4 items-center\">\n                <div className=\"w-16 h-16 rounded-xl overflow-hidden flex-shrink-0 shadow\">\n                  <img \n                    className=\"w-full h-full object-cover transition-transform group-hover:scale-105\" \n                    alt=\"Analog Warmth\" \n                    src={analogWarmthPlaylist.coverUrl}\n                  />\n                </div>\n                <div>\n                  <h5 className=\"font-display font-semibold text-sm text-white group-hover:text-primary-electric transition-colors\">\n                    {analogWarmthPlaylist.name}\n                  </h5>\n                  <p className=\"text-xs text-obsidian-on-surface-variant/40 mt-1 font-sans\">\n                    Vinyl classics\n                  </p>\n                </div>\n                <button className=\"ml-auto w-9 h-9 rounded-full bg-white/10 hover:bg-primary-electric hover:text-black flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all cursor-pointer\">\n                  <Play className=\"w-4 h-4 fill-current translate-x-0.5\" />\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n}\n"
