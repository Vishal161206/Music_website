          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        setPacketHealth(prev => Math.max(99.8, Math.min(100, prev + (Math.random() * 0.1 - 0.05))));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        setLiveBitrate(128); // Standard Idle Standby Compression"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        setLiveDB(0); // Silent room index"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
