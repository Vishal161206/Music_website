          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        setPacketHealth(100);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
